#!/usr/bin/env python3
"""Write the salted decoder's packed frame cells and their chunked kernel checks.

The salted guest's frame cells (`LeanVM/SaltedGuest/Decoder/GuestTables.lean`, `guestLocsList`) are
held by the salted decoder program as one list of natural numbers per function, each the next `64`
cells in base `2^16`, the first lowest (`SaltedGuest/Decoder/Cells.lean`: `packCells`, `cellIn`).
Written here:

* `LeanVM/SaltedGuest/Decoder/Locs.lean`: `locsBlocksList`, function `j`'s blocks at `j`, in parts
  of `512` functions as `guestLocsList` (`__loop2`'s, function `39`, a list of its own,
  `locsBlocksRow39`);
* `LeanVM/SaltedGuest/Decoder/LocsCheck/C{k}.lean`: consecutive functions of a part, their blocks
  the rows packed (`rowsOkP`), or a piece of function `39`'s blocks (`blocksOkN`), by
  `decide +kernel` on at most `--limit` cells;
* `LeanVM/SaltedGuest/Decoder/LocsCheck.lean`: every function's (`locsBlocks_ok`).

Run from any directory after `scripts/decoder-tables --salted`; `--check` fails when a file
differs, is missing, or is a chunk no longer written.
"""
import argparse, glob, os, re, sys
from pathlib import Path

DATA = "LeanVM/SaltedGuest/Data"
OUT = Path("LeanVM/SaltedGuest/Decoder/Locs.lean")
CHECK_DIR = Path("LeanVM/SaltedGuest/Decoder/LocsCheck")
CHECK_TOP = Path("LeanVM/SaltedGuest/Decoder/LocsCheck.lean")
HEADER = "Generated by `scripts/salted-decoder-locs`; do not edit."
PART = 512  # functions per part, as `guestLocsList`'s (`scripts/decoder-tables`)
SPLIT = 39  # `__loop2`: its row a list of its own, checked in pieces
BLOCK = 64  # cells per block


def lists():
    """Every `certJ_wK_M : List ℕ` of the data, by name: a list literal, or cells consed onto the
    next part's list."""
    raw = {}
    for f in sorted(glob.glob(DATA + "/Cert*.lean")):
        s = open(f).read()
        for m in re.finditer(r"^def (cert\d+_w\d+_\d+) : List ℕ := (.*?)$", s, re.M):
            body = m.group(2).strip()
            if body.startswith("("):
                t = re.fullmatch(r"\(((?:\d+ :: )*)(\[\]|cert\d+_w\d+_\d+)\)", body)
                assert t, m.group(1)
                raw[m.group(1)] = ([int(x) for x in re.findall(r"\d+", t.group(1))],
                                   None if t.group(2) == "[]" else t.group(2))
            else:
                assert re.fullmatch(r"\[[\d, ]*\]", body), m.group(1)
                raw[m.group(1)] = ([int(x) for x in re.findall(r"\d+", body)], None)
    out = {}

    def get(n):
        if n not in out:
            xs, nxt = raw[n]
            out[n] = xs + (get(nxt) if nxt else [])
        return out[n]
    for n in raw:
        get(n)
    return out


def certs():
    """Each function's windows' cell lists, by name, in order."""
    out = {}
    for f in sorted(glob.glob(DATA + "/Cert*.lean")):
        s = open(f).read()
        for m in re.finditer(r"noncomputable def cert(\d+) : Check\.Cert where\n(.*?)(?=\n\n|\Z)", s, re.S):
            cells = re.search(r"  cells := \[(.*?)\]\n  ins :=", m.group(2), re.S).group(1)
            out[int(m.group(1))] = [c.strip() for c in cells.split(",") if c.strip()]
    return out


def pack(xs):
    n = 0
    for x in reversed(xs):
        assert 0 <= x < 2 ** 16
        n = x + (n << 16)
    return n


def blocks(xs):
    return [pack(xs[i:i + BLOCK]) for i in range(0, len(xs), BLOCK)]


def lit(x):
    return "0" if x == 0 else hex(x)


def nat_list(xs):
    return "[" + ", ".join(lit(x) for x in xs) + "]"


def groups(sizes, hi, limit, skip):
    """Consecutive ranges `(a, n)` of the indices `0 … hi - 1` but `skip`, each of at most
    `limit` cells (or one row)."""
    out, a, acc = [], 0, 0
    for i in range(hi):
        if i == skip:
            if i > a:
                out.append((a, i - a))
            a, acc = i + 1, 0
            continue
        if i > a and acc + sizes[i] > limit:
            out.append((a, i - a))
            a, acc = i, 0
        acc += sizes[i]
    if hi > a:
        out.append((a, hi - a))
    return out


def module(name, imports, doc, body):
    imp = f"{imports}\n\n" if imports else ""
    return (f"/-\n  {name}\n\n  {HEADER}\n-/\n\nmodule\n\n{imp}/-!\n{doc}\n-/\n\n"
            f"namespace LeanVM.SaltedGuest.Decoder\n\n@[expose] public section\n\n{body}\nend\n\n"
            f"end LeanVM.SaltedGuest.Decoder\n")


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--check", action="store_true")
    ap.add_argument("--limit", type=int, default=12000)
    a = ap.parse_args()
    os.chdir(Path(__file__).resolve().parent.parent)
    ls, ce = lists(), certs()
    n = len(ce)
    rows = [sum((ls[x] for x in ce[j] if x != "[]"), []) for j in range(n)]
    bl = [blocks(r) for r in rows]
    nparts = (n + PART - 1) // PART
    plen = [min(PART, n - p * PART) for p in range(nparts)]
    files = {}
    body = (f"set_option maxRecDepth 100000 in\n/-- Function {SPLIT}'s blocks. -/\n"
            f"noncomputable def locsBlocksRow{SPLIT} : List Nat :=\n    "
            f"{nat_list(bl[SPLIT])}\n\n")
    for p in range(nparts):
        rs = [f"locsBlocksRow{SPLIT}" if j == SPLIT else nat_list(bl[j])
              for j in range(p * PART, p * PART + plen[p])]
        body += (f"set_option maxRecDepth 100000 in\n"
                 f"/-- Functions {p * PART} to {p * PART + plen[p] - 1}'s blocks. -/\n"
                 f"noncomputable def locsBlocksList{p} : List (List Nat) := [\n    " + ",\n    ".join(rs) + "]\n\n")
    body += (f"/-- Each function's blocks of frame cells, the parts' in order. -/\nnoncomputable def locsBlocksList : List (List Nat) :=\n    "
             + " ++ ".join(f"locsBlocksList{p}" for p in range(nparts)) + "\n")
    files[OUT] = module(
        "LeanVM.SaltedGuest.Decoder.Locs", "",
        f"# The salted guest's frame cells, packed\n\nFor each of the salted guest's {n} compiled "
        f"functions `j`, its certificate's frame cells\n(`(certOf j).locs`, `GuestTables.lean`'s "
        f"`guestLocsList`) as natural numbers, each the next `{BLOCK}` cells\nin base `2^16`, the "
        f"first lowest (`Cells.lean`: `packCells`). `LocsCheck.lean` proves them the packed rows.",
        body)
    sizes = [len(r) for r in rows]
    checks = []
    for p in range(nparts):
        skip = SPLIT - p * PART if p * PART <= SPLIT < p * PART + plen[p] else None
        for (s, m) in groups(sizes[p * PART:p * PART + plen[p]], plen[p], a.limit, skip):
            checks.append(("rows", p, s, m))
    nb = a.limit // BLOCK
    npieces = (len(bl[SPLIT]) + nb - 1) // nb
    for i in range(npieces):
        checks.append(("split", i, nb, i + 1 == npieces))
    imports = ("public import LeanVM.SaltedGuest.Decoder.Cells\npublic import LeanVM.SaltedGuest.Decoder.Locs\n"
               "public import LeanVM.SaltedGuest.Decoder.GuestTables")
    for k, c in enumerate(checks):
        if c[0] == "rows":
            _, p, s, m = c
            doc = (f"# The packed frame cells of functions `{p * PART + s}` to `{p * PART + s + m - 1}`, "
                   f"checked by the kernel")
            thm = (f"set_option maxRecDepth 100000 in\ntheorem locsBlocks_ok_{k} :\n    rowsOkP {m} "
                   f"(guestLocsList{p}.drop {s}) (locsBlocksList{p}.drop {s}) = true := by\n  decide +kernel\n")
        else:
            _, i, nb, last = c
            doc = f"# Function `{SPLIT}`'s packed frame cells, piece {i}, checked by the kernel"
            l = f"(guestLocsRow{SPLIT}.flatten.drop ({BLOCK} * {nb} * {i}))"
            b = f"(locsBlocksRow{SPLIT}.drop ({nb} * {i}))"
            stmt = f"blocksOk {l} {b}" if last else f"blocksOkN {nb} {l} {b}"
            thm = (f"set_option maxRecDepth 100000 in\ntheorem locsBlocks_ok_{k} :\n    {stmt} = true := by\n"
                   f"  decide +kernel\n")
        files[CHECK_DIR / f"C{k}.lean"] = module(f"LeanVM.SaltedGuest.Decoder.LocsCheck.C{k}", imports,
                                                 doc, thm)
    splits = [k for k, c in enumerate(checks) if c[0] == "split"]
    pieces = "\n".join(f"    | {i}, _ => locsBlocks_ok_{k}" for i, k in enumerate(splits[:-1]))
    pieces += f"\n    | _ + {len(splits) - 1}, h => absurd h (by omega)"
    gl = ", ".join(f"g{p}" for p in range(nparts))
    blv = ", ".join(f"b{p}" for p in range(nparts))
    top_body = f'''theorem locsRow{SPLIT}_ok :
    blocksOk guestLocsRow{SPLIT}.flatten locsBlocksRow{SPLIT} = true :=
  blocksOk_of_pieces {nb} {len(splits) - 1} (fun i hi ↦ match i, hi with
{pieces}) locsBlocks_ok_{splits[-1]}

set_option maxRecDepth 100000 in
theorem guestLocsList_lengths :
    [{", ".join(f"guestLocsList{p}.length" for p in range(nparts))}] = [{", ".join(map(str, plen))}] := by
  decide +kernel

set_option maxRecDepth 100000 in
theorem locsBlocksList_lengths :
    [{", ".join(f"locsBlocksList{p}.length" for p in range(nparts))}] = [{", ".join(map(str, plen))}] := by
  decide +kernel

set_option maxRecDepth 100000 in
theorem guestLocsList0_row{SPLIT} : guestLocsList0.getD {SPLIT} [] = guestLocsRow{SPLIT}.flatten := rfl

set_option maxRecDepth 100000 in
theorem locsBlocksList0_row{SPLIT} : locsBlocksList0.getD {SPLIT} [] = locsBlocksRow{SPLIT} := rfl

/-- **Every function's blocks are its frame cells packed.** -/
theorem locsBlocks_ok : ∀ j < {n},
    blocksOk (guestLocsList.getD j []) (locsBlocksList.getD j []) = true := by
  intro j hj
  have hg := guestLocsList_lengths
  have hb := locsBlocksList_lengths
  simp only [List.cons.injEq, and_true] at hg hb
  obtain ⟨{gl}⟩ := hg
  obtain ⟨{blv}⟩ := hb
  rw [guestLocsList, locsBlocksList]
'''
    for p in range(nparts):
        lo = p * PART
        if p + 1 < nparts:
            top_body += f"  by_cases hp{p} : j < {lo + plen[p]}\n  · "
        else:
            top_body += "  · "
        nh = {0: 1, 1: 2}.get(p, 3)
        hs = " ".join(f"g{q}" for q in range(nh))
        hb = " ".join(f"b{q}" for q in range(nh))
        rng = "(by omega)" if p == 0 else "(by omega) (by omega)" if p + 1 < nparts else "(by omega)"
        top_body += (f"rw [getD_parts{nparts}_{p} {hs} {rng}, getD_parts{nparts}_{p} {hb} {rng}]\n"
                     f"    generalize ho : j - {lo} = o\n    have ho' : o < {plen[p]} := by omega\n")
        lines = []
        if lo <= SPLIT < lo + plen[p]:
            o = SPLIT - lo
            lines.append(f"    by_cases hs : o = {o}\n"
                         f"    · rw [hs, guestLocsList0_row{SPLIT}, locsBlocksList0_row{SPLIT}]; exact locsRow{SPLIT}_ok")
        rs = [(k, c) for k, c in enumerate(checks) if c[0] == "rows" and c[1] == p]
        for idx, (k, (_, _, s, m)) in enumerate(rs):
            if idx + 1 < len(rs):
                lines.append(f"    by_cases h{idx} : o < {s + m}\n"
                             f"    · exact rowsOkP_drop locsBlocks_ok_{k} (by omega) (by omega)")
            else:
                lines.append(f"    exact rowsOkP_drop locsBlocks_ok_{k} (by omega) (by omega)")
        top_body += "\n".join(lines) + "\n"
    files[CHECK_TOP] = module(
        "LeanVM.SaltedGuest.Decoder.LocsCheck",
        "\n".join(f"public import LeanVM.SaltedGuest.Decoder.LocsCheck.C{k}" for k in range(len(checks))),
        f"# The packed frame cells, checked\n\n`locsBlocks_ok`: every salted function's blocks "
        f"(`locsBlocksList`) are its row of `guestLocsList`\npacked, by the kernel's checks of "
        f"{len(checks)} chunks of at most {a.limit} cells (`LocsCheck/C*.lean`), function `{SPLIT}`'s "
        f"in {len(splits)}\npieces (`locsRow{SPLIT}_ok`).",
        top_body)
    stale = []
    for path, t in files.items():
        if a.check:
            if not path.exists() or path.read_text() != t:
                stale.append(str(path))
        else:
            path.parent.mkdir(parents=True, exist_ok=True)
            path.write_text(t)
    extra = [p for p in CHECK_DIR.glob("C*.lean") if p not in files]
    if a.check:
        if stale or extra:
            sys.exit("stale: " + " ".join(stale + [str(p) for p in extra])
                     + ": run scripts/salted-decoder-locs")
    else:
        for p in extra:
            p.unlink()
        print(f"{n} rows, {sum(sizes)} cells, {sum(map(len, bl))} blocks, {len(checks)} chunks")


main()
