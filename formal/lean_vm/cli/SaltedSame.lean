import LeanVM.Guest.Data.Source
import LeanVM.SaltedGuest.Data.Source
import LeanVM.Guest.Expand
import LeanVM.Guest.Renumber
import LeanVM.SaltedGuest.Transfer

/-!
# `salted-same`: the salted guest's functions that are the deployed guest's

`lake exe salted-same` expands both guests' sources (`Expand.expandProgram`, each function
renumbered, `Fn.renumber`, as their core data is) and finds the salted functions whose core IR is
a deployed function's up to the names of the loop helpers they call, and whose callees are such
functions too: the call-closed set of unchanged functions. Loop helpers are paired by their first
caller and the order in which it calls them (a helper's name is its global number, which a new
helper earlier in the source moves). It writes `LeanVM/SaltedGuest/Same/`:

* `Pairs.lean`: `loopRho`, the loop helpers whose names differ (salted, deployed), and `rho`, the
  renaming; `closed`, the closed set as (salted name, salted index, deployed index), in blocks.
* `Check{k}.lean`: the kernel's check of block `k` (`pairOk`, `Same/Defs.lean`), and
  `Closed.lean`: every block's.

`--check` writes nothing and fails when the files differ. Run it from `lean_vm`.
-/

open LeanVM.Guest LeanVM.Guest.Core

namespace SaltedSame

partial def callsS : Stmt → List String
  | .atom _ => []
  | .ite _ z n => (z.flatMap callsS) ++ (n.flatMap callsS)
  | .match_ _ arms => arms.flatMap (·.flatMap callsS)
  | .call f _ _ => [f]
  | .callIf _ f _ => [f]
  | .dispatch _ fs _ _ => fs
  | .ret _ => []

partial def sizeS : Stmt → Nat
  | .atom _ => 1
  | .ite _ z n => 1 + (z.map sizeS).sum + (n.map sizeS).sum
  | .match_ _ arms => 1 + (arms.map fun a => (a.map sizeS).sum).sum
  | _ => 1

def calls (f : Fn) : List String := (f.body.flatMap callsS).eraseDups

/-- Each function's canonical name: its own for a function that is not a loop helper, and for a
helper `parent#Lk`, `k` the order in which its first caller (in the program's order) calls it. -/
def canon (P : Program) : Std.HashMap String String := Id.run do
  let mut m : Std.HashMap String String := {}
  for f in P do
    if !f.name.startsWith "__loop" then m := m.insert f.name f.name
  let mut changed := true
  while changed do
    changed := false
    for f in P do
      if let some cn := m[f.name]? then
        for (c, k) in ((calls f).filter (·.startsWith "__loop")).zipIdx do
          if !m.contains c then
            m := m.insert c s!"{cn}#L{k}"
            changed := true
  return m

/-- A block of the closed set is closed once its functions' statements exceed this, or it has
`blockLen` functions. -/
def blockSize : Nat := 400000

def blockLen : Nat := 48

def header (mod what : String) : String :=
  s!"/-
  LeanVM.SaltedGuest.Same.{mod}

  Generated by `lake exe salted-same` (lean_vm/cli/SaltedSame.lean); do not edit.
  {what}
-/

module
"

def pairsFile (rho : List (String × String)) (blocks : List (List (String × Nat × Nat))) : String :=
  let rhoItems := rho.map fun (a, b) => s!"  ({a.quote}, {b.quote})"
  let blockDefs := blocks.zipIdx.map fun (b, k) =>
    let items := b.map fun (n, j, j') => s!"  ({n.quote}, {j}, {j'})"
    s!"/-- Block {k} of the closed set. -/\ndef block{k} : List (String × Nat × Nat) := [\n{",\n".intercalate items}\n]\n"
  let names := (List.range blocks.length).map (s!"block{·}")
  header "Pairs" "The salted guest's unchanged functions, paired with the deployed guest's." ++ s!"
public import LeanVM.SaltedGuest.Transfer

namespace LeanVM.SaltedGuest.Same

@[expose] public section

/-- The loop helpers whose salted and deployed names differ: (salted, deployed). -/
def loopRho : List (String × String) := [
{",\n".intercalate rhoItems}
]

/-- The deployed name of a salted function. -/
def rho (f : String) : String :=
  match loopRho.lookup f with
  | some g => g
  | none => f

" ++ "\n".intercalate blockDefs ++ s!"
/-- **The closed set**: the salted functions whose core IR is a deployed function's up to `rho`,
with their callees: (salted name, salted index, deployed index). -/
def closed : List (String × Nat × Nat) :=
  {names.foldr (fun n acc => if acc.isEmpty then n else s!"{n} ++ ({acc})") ""}

/-- Membership in the closed set. -/
def inS (f : String) : Bool := (closed.map (·.1)).contains f

end
end LeanVM.SaltedGuest.Same
"

def checkFile (k : Nat) (b : List (String × Nat × Nat)) : String :=
  let pairs := b.map fun (n, j, j') =>
    s!"kernel_rfl idx{j} : LeanVM.SaltedGuest.coreProgram[{j}]? = some LeanVM.SaltedGuest.Data.core{j}

kernel_rfl idxD{j} : LeanVM.Guest.coreProgram[{j'}]? = some LeanVM.Guest.Data.core{j'}

kernel_rfl body{j} : (LeanVM.Guest.Data.core{j'}).body =
  Stmt.mapCallsList rho (LeanVM.SaltedGuest.Data.core{j}).body

theorem pair{j} : PairOk ({n.quote}, {j}, {j'}) :=
  ⟨LeanVM.SaltedGuest.Data.core{j}, LeanVM.Guest.Data.core{j'}, idx{j}, idxD{j}, by decide +kernel,
    by decide +kernel, by decide +kernel, body{j}, by decide +kernel⟩
"
  let oks := b.map fun (_, j, _) => s!"pair{j}"
  header s!"Check{k}" s!"The kernel's check of block {k} of the salted guest's unchanged functions." ++ s!"
public import LeanVM.SaltedGuest.Same.Defs

namespace LeanVM.SaltedGuest.Same

open LeanVM.Guest.Core

@[expose] public section

set_option maxRecDepth 100000

{"\n".intercalate pairs}
theorem block{k}_ok : ∀ p ∈ block{k}, PairOk p := by
  simp only [block{k}, List.forall_mem_cons]
  exact ⟨{", ".intercalate oks}, fun _ h ↦ nomatch h⟩

end
end LeanVM.SaltedGuest.Same
"

def closedFile (n : Nat) : String :=
  let imports := (List.range n).map (s!"public import LeanVM.SaltedGuest.Same.Check{·}")
  let oks := (List.range n).map (s!"block{·}_ok")
  header "Closed" "The kernel's check of the salted guest's unchanged functions, every block." ++ s!"
{"\n".intercalate imports}

namespace LeanVM.SaltedGuest.Same

@[expose] public section

theorem closed_ok : ∀ p ∈ closed, PairOk p := by
  simp only [closed, List.forall_mem_append]
  exact ⟨{", ".intercalate oks}⟩

end
end LeanVM.SaltedGuest.Same
"

def files (D S : Program) : Except String (List (String × String)) := do
  let mD := canon D
  let mS := canon S
  let ρD := fun n => mD.getD n n
  let ρS := fun n => mS.getD n n
  let dIdx : Std.HashMap String (Nat × Fn) := Id.run do
    let mut h := {}
    for (f, j) in D.zipIdx do h := h.insert (ρD f.name) (j, f)
    return h
  let dName := fun c => (dIdx[ρS c]?).map (·.2.name) |>.getD c
  -- the salted functions equal to a deployed one up to the callees' names
  let mut same : Std.HashMap String (Nat × Nat × Fn) := {}
  let mut rho : Std.HashMap String String := {}
  for (f, j) in S.zipIdx do
    if let some (j', g) := dIdx[ρS f.name]? then
      let fm : Fn := { f with body := Stmt.mapCallsList dName f.body }
      if fm.params == g.params && fm.body == g.body then
        same := same.insert f.name (j, j', f)
        rho := rho.insert f.name g.name
  -- the call-closed part: drop every function that reaches one not in `same`
  let names := S.map (·.name)
  let callsOf : Std.HashMap String (List String) := Id.run do
    let mut h := {}
    for f in S do h := h.insert f.name (calls f)
    return h
  let mut bad : Std.HashSet String := {}
  for n in names do
    if !same.contains n then bad := bad.insert n
  let mut changed := true
  while changed do
    changed := false
    for n in names do
      if !bad.contains n && (callsOf.getD n []).any bad.contains then
        bad := bad.insert n
        changed := true
  let closed := S.zipIdx.filterMap fun (f, j) =>
    if bad.contains f.name then none else (same[f.name]?).map fun (_, j', g) => (f.name, j, j', g)
  -- blocks by size
  let mut blocks : Array (List (String × Nat × Nat)) := #[]
  let mut cur : Array (String × Nat × Nat) := #[]
  let mut size := 0
  for (n, j, j', g) in closed do
    let s := (g.body.map sizeS).sum
    if (size + s > blockSize || cur.size ≥ blockLen) && !cur.isEmpty then
      blocks := blocks.push cur.toList
      cur := #[]
      size := 0
    cur := cur.push (n, j, j')
    size := size + s
  if !cur.isEmpty then blocks := blocks.push cur.toList
  let loopRho := names.filterMap fun n =>
    if bad.contains n then none else (rho[n]?).bind fun d => if d == n then none else some (n, d)
  let pairs := ("Pairs", pairsFile loopRho blocks.toList)
  let checks := blocks.toList.zipIdx.map fun (b, k) => (s!"Check{k}", checkFile k b)
  return pairs :: ("Closed", closedFile blocks.size) :: checks

end SaltedSame

open SaltedSame in
def main (args : List String) : IO UInt32 := do
  let check := args == ["--check"]
  unless args.isEmpty || check do
    IO.eprintln "usage: salted-same [--check]"
    return 2
  let D ← match Expand.expandProgram Data.guest with
    | .ok P => pure (P.map Fn.renumber)
    | .error e => do IO.eprintln s!"expansion failed: {e}"; return 1
  let S ← match Expand.expandProgram LeanVM.SaltedGuest.Data.guest with
    | .ok P => pure (P.map Fn.renumber)
    | .error e => do IO.eprintln s!"expansion failed: {e}"; return 1
  let fs ← match files D S with
    | .ok fs => pure fs
    | .error e => do IO.eprintln e; return 1
  let dir : System.FilePath := "LeanVM/SaltedGuest/Same"
  IO.FS.createDirAll dir
  let names := fs.map fun (n, _) => n ++ ".lean"
  let existing ← (← dir.readDir).filterMapM fun e => pure (if e.fileName.endsWith ".lean" &&
    e.fileName != "Defs.lean" then some e.fileName else none)
  let stale := existing.toList.filter (!names.contains ·)
  let mut bad := false
  for (n, text) in fs do
    let path := dir / (n ++ ".lean")
    let old ← if ← path.pathExists then IO.FS.readFile path else pure ""
    if old != text then
      if check then
        IO.eprintln s!"stale: {path}"
        bad := true
      else IO.FS.writeFile path text
  for n in stale do
    if check then
      IO.eprintln s!"stale: {dir / n}"
      bad := true
    else IO.FS.removeFile (dir / n)
  IO.println s!"{fs.length} files"
  return if bad then 1 else 0
