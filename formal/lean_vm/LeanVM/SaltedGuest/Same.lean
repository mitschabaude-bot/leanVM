/-
  LeanVM.SaltedGuest.Same

  The salted guest's unchanged functions have the deployed guest's call relation.
-/

module

public import LeanVM.SaltedGuest.Same.Closed

/-!
# The unchanged functions

`agreesOn`: the salted core IR agrees with the deployed one on the closed set of unchanged
functions (`Same.closed`, generated by `lake exe salted-same`), up to the renaming `Same.rho` of
the loop helpers, by the kernel's check of every pair (`Same.closed_ok`).

`rel_same`: so a function of the closed set has, in the salted core IR, the deployed call
relation of its deployed name; `rel_same'` for a name `rho` keeps (every function but the renamed
loop helpers). Each deployed `…_holds` of a function of the closed set holds of the salted core IR
through it.
-/

namespace LeanVM.SaltedGuest.Same

open LeanVM.Parameters LeanVM.Guest LeanVM.Guest.Core

@[expose] public section

theorem agreesOn : AgreesOn SaltedGuest.coreProgram Guest.coreProgram rho inS :=
  agreesOn_of closed_ok

/-- **An unchanged function's relation**: in the salted core IR, the deployed relation of its
deployed name. -/
theorem rel_same (rd : Reader) {f : String} (hf : inS f = true) (args rets : List E) :
    SaltedGuest.coreProgram.Rel rd f args rets ↔ Guest.coreProgram.Rel rd (rho f) args rets :=
  rel_transfer agreesOn rd hf args rets

/-- **An unchanged function's relation**, for a name `rho` keeps. -/
theorem rel_same' (rd : Reader) {f : String} (hf : inS f = true) (hr : rho f = f)
    (args rets : List E) :
    SaltedGuest.coreProgram.Rel rd f args rets ↔ Guest.coreProgram.Rel rd f args rets := by
  rw [rel_same rd hf, hr]

end
end LeanVM.SaltedGuest.Same
