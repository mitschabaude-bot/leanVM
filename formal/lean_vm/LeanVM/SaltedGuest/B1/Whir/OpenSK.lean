/-
  LeanVM.SaltedGuest.B1.Whir.OpenSK

  The salted `open_stacked` is sound at every stack size and rate: its run at the keyed hash.
  The copies of `open_generic`, `calleesOk_of` and `qwOk_of` are generated by
  `scripts/salted-whir/chaincopy.py` from `Guest/B1/Whir/Open.lean` and `Sound.lean`.
-/

module

public import LeanVM.SaltedGuest.B1.Whir.LevelsK
public import LeanVM.SaltedGuest.B1.Whir.LqDataAll
public import LeanVM.SaltedGuest.B1.Whir.OsDataAll
public import LeanVM.SaltedGuest.B1.Whir.OsSame
public import LeanVM.SaltedGuest.B1.Merkle.CapAll
public import LeanVM.Guest.B1.Whir.Sound
public import LeanVM.Guest.B1.Whir.Finish
public import LeanVM.Guest.B1.Whir.Head

/-!
# The salted `open_stacked`, soundly

`open_stacked`'s body is unchanged; its `level_queries` reads the key of the seed in memory words
`2` and `3`, and checks the cap and the queries under it.

* `OpenOutWK S`: the deployed `OpenOutW` with the run at `keyedHash S` (`RunsWithH`).
* `OqWit`, `OqSoundK Wq`: the queries' witness of a level's `opening_queries` call, as a function
  of the memory, the frame map, the level and the call's words, and its soundness: every call of a
  level's specialization, under a call relation below the salted core IR's unfolding at `V`, is
  `LvQWK` at `Wq rd V lvl lv`.
* `open_stacked_osWK Wq`: the deployed witness `open_stacked_osW`, the openings read through the
  salted `level_queries`' call (`lqCallK`) with the queries' witness `Wq`.
* `open_stacked_sound_wK`: given `OqSoundK Wq`, the deployed `open_stacked_sound_w` for the salted
  core IR and the keyed hash, with the seed `S` of memory words `2` and `3`: the unchanged callees
  by their deployed meanings through the transfer (`toD`, the tables' names unchanged functions,
  `tabSame`), the cap by `Merkle.verify_merkle_cap_sound_holds`, `level_queries` by its salted
  template (`lqTableK_ok`), the sizes' bodies (`osDataK_all`).
-/

namespace LeanVM.SaltedGuest.B1.Whir

open LeanVM.Parameters LeanVM.Semantics LeanVM.Guest.Core LeanVM.Guest LeanVM.Guest.B1
open LeanVM.Guest.Value LeanVM.Protocol LeanVM.Protocol.KeccakHash LeanVM.Protocol.Compile
open LeanVM.Protocol.Verifier LeanVM.Guest.B1.Whir LeanVM.SaltedGuest.B1 Recursion.Salted

@[expose] public section

variable {rd : Reader} {σ : Val}

/-! ## The statement -/

/-- **`OpenOutW` at the keyed hash**: the deployed `OpenOutW` with the run at `keyedHash S`. -/
def OpenOutWK (S : Digest) (rd : Reader) (μ r : ℕ) (root : Digest) (fs : List E) (target cur : E)
    (rets : List E) (xs : List E) (os : List (List Opening)) : Prop :=
  ∃ (w : WhirEnd) (s' : Fs) (roots' : List (Digest × ℕ × ℕ)),
    ReadsAt rd cur xs ∧
    RunsWithH (keyedHash S) (whirOpen μ r target) ⟨fs, []⟩ xs os [(root, stackShape μ r)] w s'
      roots' ∧
    w.point.length = μ ∧
    ∃ pt pt1 : E, rets = [w.target, pt, pt1, w.inner, w.residual] ∧
      ReadsAt rd pt (w.point ++ List.replicate (pointCap - μ) 0) ∧
      ReadsAt rd pt1 (w.point.map (1 + ·) ++ List.replicate (pointCap - μ) 1)

/-- A level's queries' witness: from the memory, the frame map, the level, its row and the words
of its `opening_queries` call. -/
abbrev OqWit : Type :=
  Reader → SaltedGuest.End.FrameMap → ℕ → OsLv → List E → List E → List QW

/-- **The queries' witness `Wq` is sound**: under a call relation below the salted core IR's that
unfolds at `V`, a level's `opening_queries` calls are `LvQWK` at `Wq rd V lvl lv`, at a row whose
names are in their tables. -/
def OqSoundK (Wq : OqWit) : Prop :=
  ∀ (rd : Reader) (C : CallRel) (V : SaltedGuest.End.FrameMap), SaltedGuest.End.UnfoldsV rd C V →
    CallRel.Le C (SaltedGuest.coreProgram.Rel rd) → ∀ (c : OsCfg) (lvl : ℕ) (lv : OsLv),
      NamesOk c lvl lv → LvQWK rd C lvl lv (Wq rd V lvl lv)

/-- A level's openings from its salted `level_queries` call on `args`, returning `rets`: those of
the `opening_queries` call in the callee's frame, with the queries' witness `Wq`. -/
def lqOpeningsK (Wq : OqWit) (rd : Reader) (Fr : SaltedGuest.End.FrameMap) (lvl : ℕ) (lv : OsLv)
    (args rets : List E) : List Opening :=
  lvOpenings rd (Fr (osQueriesName lvl lv) args rets) lv (Wq rd Fr lvl lv) (lqCallK lvl lv)

/-- A level's openings, from its `level_queries` dispatch's words in `σ` and the frames `Fr`. -/
def osLevelOsK (Wq : OqWit) (rd : Reader) (σ : Val) (Fr : SaltedGuest.End.FrameMap) :
    ℕ × OsLv × String × List Core.V × List Core.V → List Opening
  | (lvl, lv, _, args, rets) => lqOpeningsK Wq rd Fr lvl lv (args.map σ) (rets.map σ)

/-- **The salted `open_stacked`'s witness** at the size `m` and the rate `r`: the deployed
`open_stacked_osW`, the openings read through the salted `level_queries` with `Wq`. -/
def open_stacked_osWK (Wq : OqWit) (rd : Reader) (m r : ℕ) (σ : Val)
    (V : SaltedGuest.End.FrameMap) : List E × List (List Opening) :=
  (readN rd (σ (.n 9)) (osWordsLen (osCfgR m (r - 1))),
    (osQCalls (osCfgR m (r - 1)) 0 (osCfgR m (r - 1)).levels
      (osHead (osCfgR m (r - 1))).2).map (osLevelOsK Wq rd σ V))

/-- **The salted `open_stacked` is sound with its witness `open_stacked_osWK Wq`**: the deployed
`open_stacked_sound_w_Spec` over the salted core IR, with the seed `S` of memory words `2` and `3`,
the run at `keyedHash S`. -/
def open_stacked_sound_w_SpecK (Wq : OqWit) : Prop :=
  ∀ {κ : ℕ}, κ ≤ 32 → ∀ (L : MemoryImage κ) (C : CallRel) (V : SaltedGuest.End.FrameMap),
    SaltedGuest.End.UnfoldsV L.read C V → CallRel.Le C (SaltedGuest.coreProgram.Rel L.read) →
    ∀ (S : Digest), LoadHolds L.read 1 2 (digestHalves S).1 →
      LoadHolds L.read 1 3 (digestHalves S).2 →
    ∀ (μ r : ℕ), minOpenLog ≤ μ → μ ≤ 30 → 1 ≤ r → r ≤ 4 →
      ∀ (root : Digest) (fs : List E) (target root0 root1 cur : E) (rets : List E) (fn : Fn)
        (σ : Val), fs.length = 5 → (root0, root1) = digestHalves root →
        SaltedGuest.coreProgram.find? (openName μ) = some fn →
        fn.params.map σ = rateSel r :: fs ++ [target, root0, root1, cur] →
        Stmt.HoldsList C L.read σ fn.body False (fun rs ↦ rs = rets) →
        OpenOutWK S L.read μ r root fs target cur rets
          (open_stacked_osWK Wq L.read (μ - minOpenLog) r σ V).1
          (open_stacked_osWK Wq L.read (μ - minOpenLog) r σ V).2

/-! ## The unchanged callees -/

/-- A table's names are unchanged functions of the salted guest, so their salted calls are their
deployed ones. -/
theorem tabSame {α : Type} {tab : List (String × α)}
    (hall : ∀ e ∈ tab, Same.inS e.1 = true ∧ Same.rho e.1 = e.1) {e : String × α}
    (he : e ∈ tab) {a r : List E} (h : SaltedGuest.coreProgram.Rel rd e.1 a r) :
    Guest.coreProgram.Rel rd e.1 a r :=
  toD (hall e he).1 (hall e he).2 h

theorem toD_same {f : String} (hf : Same.inS f = true ∧ Same.rho f = f) {a r : List E}
    (h : SaltedGuest.coreProgram.Rel rd f a r) : Guest.coreProgram.Rel rd f a r :=
  toD hf.1 hf.2 h

/-- **A level's callees**, at the salted core IR: the unchanged ones by their deployed meanings,
the cap under the key, `level_queries` its salted template. -/
theorem lvCallees_ofK {κ : ℕ} (hκ : κ ≤ 32) (L : MemoryImage κ) {c : OsCfg} {lvl : ℕ} {lv : OsLv}
    (hs : LvStatic c lvl lv) (hn : NamesOk c lvl lv) : LvCalleesK L.read c lvl lv := by
  obtain ⟨⟨hood, hfm, hgr, hdec, hcap, -, hrw, hfo⟩, hlp, hlq, hlr, hrb, hpw, hn0, hn, hn5,
    hq8⟩ := hn
  have hlq' := lqTableK_ok _ hlq
  refine ⟨fun a r h ↦ (assert_canonical_holds L.read a r).mp (toD_same same_assert_canonical h),
    fun hnf a r h ↦ (opening_ood_point_all_holds _ (hood hnf) L.read a r).mp
      (tabSame oodSame (hood hnf) h),
    fun a r h ↦ (opening_final_message_holds _ hfm L.read a r).mp (tabSame fmSame hfm h),
    fun a r h ↦ by
      rw [hgr] at h; exact (grind_check_holds L.read a r).mp (toD_same same_grind_check_L17 h),
    ⟨fun a r h hw ↦ lp_callee hκ L hlp hdec hpw hn0 hn hn5 a r (tabSame lpSame hlp h) hw, hlq',
      fun a r h ↦ rw_callee hrw hfo a r (by
        rw [hrw] at h ⊢
        by_cases h0 : lvl = 0
        · simp only [h0, ↓reduceIte] at h ⊢; exact toD_same same_opening_row_weights_L6_L1 h
        · simp only [h0, ↓reduceIte] at h ⊢; exact toD_same same_opening_row_weights_L4_L0 h),
      fun a r h ↦ verify_merkle_cap_sound_holds _ hcap L.read a r h⟩,
    fun a r h ↦ lr_callee hlr hrb hs.ml1 hs.qo hs.qu hq8 a r (tabSame lrSame hlr h)⟩

/-- What a level's residual sum reads: `level_residual`'s meaning at the rate's row, its
positions, `μ = λ⁻¹` in `level_mus`. -/
def ResInK (rd : Reader) (σ : Val) (c : OsCfg) (lvl : ℕ) (lv : OsLv) (P : ℕ → E) (lam : E) :
    Prop :=
  (∀ args rets, SaltedGuest.coreProgram.Rel rd (osResidualName lv) args rets →
      MeaningLevelResidual lv.queries lv.logCols rd args rets) ∧ LvRate σ c lvl lv ∧
    lv.vanish = vanishOff lv.logCols ∧ lv.posOff < u128Bound ∧ lvl * ligColsCap < u128Bound ∧
    lv.prefixLen + c.yrLog = lv.logCols ∧
    (∀ i < lv.queries, LoadHolds rd (σ (.n osQpos)) (lv.posOff + i) (P i)) ∧ lam ≠ 0 ∧
    LoadHolds rd (σ (.n osMus)) lvl lam⁻¹

theorem osResiduals_soundK {c : OsCfg} {ich bd ls : ℕ} (G : ℕ → E) (levels : List OsLv) :
    ∀ (lvl : ℕ) (mats : List OsMat) (k : ℕ) (I : E),
      (∀ i (hi : i < levels.length) (mats' : List OsMat) (k' : ℕ) (I' : E), MatsOk σ mats' →
        AllOk (SaltedGuest.coreProgram.Rel rd) rd σ (osResidual c ich bd ls (lvl + i) levels[i] mats' k').1 →
        LoadHolds rd (σ (.n ich)) (lvl + i) I' →
        LoadHolds rd (σ (.n ich)) (lvl + i + 1) (I' + G (lvl + i)) ∧
          MatsOk σ (osResidual c ich bd ls (lvl + i) levels[i] mats' k').2.1) →
      MatsOk σ mats →
      AllOk (SaltedGuest.coreProgram.Rel rd) rd σ (osResiduals c ich bd ls lvl levels mats k).1 →
      LoadHolds rd (σ (.n ich)) lvl I →
      LoadHolds rd (σ (.n ich)) (lvl + levels.length)
        (I + ∑ i ∈ Finset.range levels.length, G (lvl + i)) := by
  induction levels with
  | nil => intro lvl _ _ I _ _ _ h; simpa using h
  | cons lv rest ih =>
    intro lvl mats k I hstep hm hok h
    simp only [osResiduals] at hok
    rw [allOk_append] at hok
    have h1 := hstep 0 (by simp) mats k I hm hok.1 (by simpa using h)
    have := ih (lvl + 1) _ _ _ (fun i hi mats' k' I' hm' h1 h2 ↦ by
      have := hstep (i + 1) (by simp; omega) mats' k' I' hm'
        (by rwa [show lvl + (i + 1) = lvl + 1 + i by ring]) (by
          rwa [show lvl + (i + 1) = lvl + 1 + i by ring])
      rwa [show lvl + (i + 1) = lvl + 1 + i by ring] at this) (by simpa using h1.2) hok.2
      (by simpa using h1.1)
    have e : I + ∑ i ∈ Finset.range (lv :: rest).length, G (lvl + i) =
        I + G lvl + ∑ i ∈ Finset.range rest.length, G (lvl + 1 + i) := by
      rw [List.length_cons, Finset.sum_range_succ', Finset.sum_congr rfl
        (fun i _ ↦ by rw [show lvl + (i + 1) = lvl + 1 + i by ring])]
      simp only [Nat.add_zero]
      ring
    rw [e, List.length_cons, show lvl + (rest.length + 1) = lvl + 1 + rest.length by ring]
    exact this

/-- **The finish** (G:1518-1608). -/
theorem osFinish_soundK {c : OsCfg} {st : OsSt} {tch : ℕ} {ms T Pt : List E} {β Λ Lam : ℕ → E}
    {X P W Z Y : ℕ → ℕ → E} (hW : ∀ i j, W i j = Lam i ^ j)
    (hfm : ∀ args rets, SaltedGuest.coreProgram.Rel rd ("fold_final_msg__L" ++ natStr c.yrLog) args rets →
      MeaningFoldFinalMsg c.yrLog rd args rets)
    (hms : ms.length = 2 ^ c.yrLog) (hmsr : ReadsAt rd (σ (.n osFmsg)) ms)
    (hT : T.length = c.yrLog) (hTr : ReadsAt rd (σ (.n tch)) T)
    (hpt : ∀ i, PtSrcOk rd σ (osPtSrc c tch i) (Pt.getD i 0))
    (hbasis : ∀ i (hi : i < c.levels.length), BasisIn rd σ c tch i c.levels[i]
      (β i * Lam i ^ c.levels[i].queries) (X i))
    (hres : ∀ i (hi : i < c.levels.length), ResInK rd σ c i c.levels[i] (P i) (Lam i))
    (hood : OodAll rd σ c tch Λ Z Y (c.levels.headD default).logCols 1 c.levels.tail)
    (hn2 : 2 ≤ c.levels.length) (hmats : MatsOk σ st.mats)
    (hok : AllOk (SaltedGuest.coreProgram.Rel rd) rd σ (osFinishA c st tch)) :
    (osFinishRet c st tch).map σ = [σ (.n st.t), σ (.n (st.k + 1)), σ (.n (st.k + 1 + 1)),
      finInner c β X P W Λ Z Y, multilinearEval ms T] ∧
    (∀ i < pointCap, LoadHolds rd (σ (.n (st.k + 1))) i (Pt.getD i 0) ∧
      LoadHolds rd (σ (.n (st.k + 1 + 1))) i (1 + Pt.getD i 0)) ∧
    ∀ i (hi : i < c.levels.length), ∀ t < c.levels[i].prefixLen + c.yrLog,
      X i t * invW c.levels[i] t ≠ 0 := by
  simp only [osFinishA, osFinishRet] at hok ⊢
  set pts := osPtBlks c (st.k + 1) (st.k + 1 + 1) tch 0 pointCap (st.k + 1 + 2) with hpts
  set bs := osBases c tch (pts.2 + 1) (pts.2 + 3) 0 c.levels (pts.2 + 4) with hbs
  set rs := osResiduals c (bs.2 + 1) (pts.2 + 1) (pts.2 + 3) 0 c.levels st.mats (bs.2 + 3) with hrs
  set od := osOodWeights c tch (c.levels.headD default).logCols 1 c.levels.tail none rs.2 with hod
  simp only [allOk_append] at hok
  obtain ⟨⟨⟨⟨⟨⟨⟨⟨⟨hA, hP⟩, -⟩, -⟩, hB⟩, -⟩, hZ⟩, hR⟩, hO⟩, hE⟩ := hok
  -- the final message folded at the tail challenges
  simp only [allOk_cons, allOk_nil, and_true, Whir.StmtOk, List.map_cons, List.map_nil] at hA
  obtain ⟨m, ps, hml, hpsl, hmr, hpr, hy⟩ := hfm _ _ hA.1
  have em := readsAt_unique (by rw [hml, hms]) hmr hmsr
  have ep := readsAt_unique (by rw [hpsl, hT]) hpr hTr
  simp only [List.cons.injEq, and_true] at hy
  -- the point
  have hpoint := osPtBlks_sound (C := SaltedGuest.coreProgram.Rel rd) (fun i ↦ Pt.getD i 0) hpt pointCap 0 _ hP
  -- the bases
  have hbo := osBases_sound (C := SaltedGuest.coreProgram.Rel rd) (bd := pts.2 + 1) (ls := pts.2 + 3)
    (fun i ↦ β i * Lam i ^ (c.levels.getD i default).queries) X
    c.levels 0 _ (fun i hi ↦ by
      simp only [Nat.zero_add, List.getD_eq_getElem _ _ hi]; exact hbasis i hi) hB
  -- the residual sums
  simp only [allOk_cons, allOk_nil, and_true, Whir.StmtOk, Atom.Holds] at hZ
  obtain ⟨z0, s0⟩ := hZ
  rw [z0, word_zero] at s0
  have hich := osResiduals_soundK (rd := rd) (σ := σ) (c := c) (ich := bs.2 + 1) (bd := pts.2 + 1)
    (ls := pts.2 + 3) (fun i ↦ (β i * ∏ t ∈ Finset.range ((c.levels.getD i default).prefixLen +
        c.yrLog), (X i t * invW (c.levels.getD i default) t)) *
      ∑ j ∈ Finset.range (c.levels.getD i default).queries,
        W i j * lvRes (c.levels.getD i default) (dOf (c.levels.getD i default) (X i)) (P i j))
    c.levels 0 st.mats _ 0 (fun i hi mats' k' I' hm' h1 h2 ↦ by
      simp only [Nat.zero_add] at h1 h2 ⊢
      obtain ⟨hf, hrate, hvan, hpo, hlc, hlen, hPq, hl0, hM⟩ := hres i hi
      obtain ⟨hD, hL⟩ := hbo i hi
      simp only [Nat.zero_add] at hD hL
      have hgd : c.levels.getD i default = c.levels[i] := by
        rw [List.getD_eq_getElem _ _ hi]
      rw [hgd] at hL ⊢
      obtain ⟨this, hmo⟩ := osResidual_sound hf hrate hvan hpo hlc hm' (D := dOf c.levels[i] (X i))
        (fun s hs ↦ (hD s (by omega)).2) hPq hM h2 hL h1
      refine ⟨?_, hmo⟩
      convert this using 2
      simp only [hW, lvRes]
      rw [← resFold_lam hl0]
      ring) hmats hR (by simpa using s0)
  -- the out-of-domain weights
  obtain ⟨x, hx, hxv⟩ := osOodWeights_sound (C := SaltedGuest.coreProgram.Rel rd) Λ Z Y c.levels.tail
    (c.levels.headD default).logCols 1 none rs.2 hood hO (Or.inr (by
      intro h
      have := congrArg List.length h
      simp at this
      omega))
  -- the returns
  simp only [allOk_cons, allOk_nil, and_true, Whir.StmtOk, Atom.Holds] at hE
  obtain ⟨e0, e1, e2, l3, a4, e5⟩ := hE
  rw [hx, Option.getD_some, hxv, loadHolds_unique l3 (by simpa using hich)] at a4
  refine ⟨?_, fun i hi ↦ by simpa using hpoint i hi, fun i hi t ht ↦ by
    simpa using ((hbo i hi).1 t ht).1⟩
  simp only [List.map_cons, List.map_nil, e0, e1, e2, a4, e5, hy, em, ep, accVal, zero_add,
    finInner, List.getD_eq_getElem?_getD]

/-- **The head**: the two words read at the cursor run the first round polynomial; the first
level starts from the guest's state. -/
theorem osHead_soundK {c : OsCfg} {fs : List E} {sel target root0 root1 cur : E} {root : Digest}
    {shape : ℕ × ℕ} (hfs : fs.length = 5)
    (hp : (osParams 10).map σ = sel :: fs ++ [target, root0, root1, cur])
    (hroot : (root0, root1) = digestHalves root)
    (hshape : shape = ((c.levels.headD default).depth, lvWidth 0 (c.levels.headD default)))
    (hoff : (c.levels.headD default).foldsOff = 0)
    (hok : AllOk (SaltedGuest.coreProgram.Rel rd) rd σ (osHead c).1) :
    ∃ c0 c2 : E, ReadsAt rd cur [c0, c2] ∧
      RunsTo (sumcheckRoundPoly 3 target none) ⟨fs, []⟩ [c0, c2] [c0, target + c2, c2]
        ((osHead c).2.F σ) ∧
      LvIn rd σ 0 (c.levels.headD default) (osHead c).2 ⟨target, [c0, target + c2, c2], [], []⟩
        [(root, shape)] root ∧
      (osHead c).2.cur σ = cur * gen ^ 2 ∧ WinTabs rd (σ (.n osWin)) := by
  obtain ⟨f0, f1, f2, f3, f4, rfl⟩ : ∃ f0 f1 f2 f3 f4, fs = [f0, f1, f2, f3, f4] := by
    match fs, hfs with
    | [f0, f1, f2, f3, f4], _ => exact ⟨f0, f1, f2, f3, f4, rfl⟩
  simp only [osParams, List.range_succ, List.range_zero, List.map_cons, List.map_nil,
    List.nil_append, List.cons_append, List.cons.injEq, and_true] at hp
  obtain ⟨-, e1, e2, e3, e4, e5, e6, e7, e8, e9⟩ := hp
  have hwin : AllOk (SaltedGuest.coreProgram.Rel rd) rd σ osWinTabs := fun s hs ↦ hok s (by
    simp only [osHead, List.mem_append]; tauto)
  simp only [osHead, allOk_append, allOk_cons, allOk_nil, and_true, Whir.StmtOk, Atom.Holds,
    osHeap, and_assoc] at hok
  obtain ⟨l10, l11, a12, -, -, s7, s8, -⟩ := hok
  have hF : (OsSt.F σ (osHead c).2) = ⟨[f0, f1, f2, f3, f4], [(σ (.n 10), dsObserve),
      (σ (.n 11), dsObserve)]⟩ := by
    simp [OsSt.F, OsSt.fsv, osHead, e1, e2, e3, e4, e5]
  refine ⟨σ (.n 10), σ (.n 11), ?_, ?_, ?_, ?_, osWinTabs_sound hwin⟩
  · intro i hi
    rw [← e9]
    rcases i with _ | _ | i
    · exact l10
    · exact l11
    · simp at hi
  · rw [hF]
    have := runsTo_round3 ⟨[f0, f1, f2, f3, f4], []⟩ target (σ (.n 10)) (σ (.n 11))
    refine RunsTo.of_eq this rfl rfl rfl ?_
    simp [Fs.absorbAll, Fs.absorb, rateScalars]
  · refine ⟨rfl, by simp [osHead], trivial, ?_, by simp [osHead, e6], by rw [hoff]; rfl,
      fun j hj ↦ by simp at hj, rfl, by simp [hshape, lvWidth], ?_, ?_, ?_⟩
    · simp [OsSt.quad, osHead, a12, e6]
    · rw [← hroot]; simpa [e7] using s7
    · rw [← hroot]; simpa [e8] using s8
    · exact matsOk_nil σ
  · simp [OsSt.cur, osHead, e9]

/-- **A configuration, soundly**: from its body, its facts, its callees' meanings and the rate's
selector naming its levels' rows, a call establishes `OpenOut`. -/
theorem open_genericK {name : String} {μ r : ℕ} {c : OsCfg} {cfg : List Whir.Level}
    (hfnc : FnIsK name (osParams 10) (osBody c))
    (hF : CandFacts c μ r cfg) (hcal : CalleesOkK rd c 0 c.levels)
    (hfold : ∀ args rets, SaltedGuest.coreProgram.Rel rd "opening_fold" args rets →
      MeaningOpeningFold rd args rets)
    (hfm : ∀ args rets, SaltedGuest.coreProgram.Rel rd ("fold_final_msg__L" ++ natStr c.yrLog)
      args rets → MeaningFoldFinalMsg c.yrLog rd args rets)
    {root : Digest} {fs : List E} {sel target root0 root1 cur : E} {rets : List E}
    (hfs : fs.length = 5) (hroot : (root0, root1) = digestHalves root)
    {C : CallRel} (hle : CallRel.Le C (SaltedGuest.coreProgram.Rel rd)) {V : SaltedGuest.End.FrameMap} (hU : SaltedGuest.End.UnfoldsV rd C V)
    {S : Digest} (hS2 : LoadHolds rd 1 2 (digestHalves S).1)
    (hS3 : LoadHolds rd 1 3 (digestHalves S).2)
    {Wf : ℕ → OsLv → List E → List E → List QW} (hqw : QWOkK rd C Wf 0 c.levels)
    {σ : Val} (hrat : RatesOk σ c 0 c.levels) {fn' : Fn} (hfind' : SaltedGuest.coreProgram.find? name = some fn')
    (hp' : fn'.params.map σ = sel :: fs ++ [target, root0, root1, cur])
    (hh : Stmt.HoldsList C rd σ fn'.body False (fun rs ↦ rs = rets)) :
    OpenOutWK S rd μ r root fs target cur rets (readN rd cur (osWordsLen c))
      ((osQCalls c 0 c.levels (osHead c).2).map
        (fun e ↦ lvOsK rd σ V (Wf e.1 e.2.1) e.1 e.2.1 e.2.2)) := by
  have hn := hF.n2
  obtain ⟨fn, hfind, hps, hbody⟩ := hfnc
  rw [hfind] at hfind'
  cases hfind'
  have hp := hp'
  rw [hbody, osBody_split, holdsList_flat_ret _ (osBodyA_flat c)] at hh
  obtain ⟨hok, hret⟩ := hh
  rw [hps] at hp
  simp only [osBodyA, allOk_append] at hok
  obtain ⟨⟨⟨hH, hL⟩, hT⟩, hFin⟩ := hok
  -- the head
  obtain ⟨c0, c2, hrd0, hrun0, hin0, hcur0, hwt⟩ :=
    osHead_soundK (c := c) hfs hp hroot hF.shape hF.off0 (allOk_mono hle hH)
  -- the levels
  obtain ⟨xs1, os1, R', ms, ws', rs, hrd1, hrun1, hmsl, hfmr, hgl, hrsl, hrec, hfl, hfch, hq, ht,
    hfs1, hpad1, hco1, hcur1, hos1, hxl1, hmt1⟩ :=
    osLevels_soundK hle hU hS2 hS3 c.levels cfg 0 (osHead c).2 _ _ root hF.lok hcal hqw hrat hin0 hwt hL
  obtain ⟨p, hpp⟩ := osLevels_pad c c.levels 0 (osHead c).2 (by
    intro h; rw [h] at hn; simp at hn)
  set stL := (osLevels c 0 c.levels (osHead c).2).2 with hstL
  -- the tail
  obtain ⟨xs2, T, F', hxl2, hTl, hrd2, hrun2, hTr, -⟩ := osTail_sound hfold hF.ylog hfs1
    (by have := hco1; unfold u128Bound; omega) (by rw [hpp] at hpad1 ⊢; exact hpad1) ws' hq ht
    (allOk_mono hle hT)
  set stT := (osTail c stL).2 with hstT
  have hmtT : MatsOk σ stT.1.mats := by
    have e : stT.1.mats = stL.mats := by simp [stT, osTail, osFolds_mats]
    rw [e]; exact hmt1
  set F := ws'.folds with hFdef
  have hFl : F.length = c.nFolds := by
    rw [hfl, ← hF.lastF]
  set lane := (c.levels.headD default).folds with hlane
  obtain ⟨hlane', hcne⟩ := levelsOk_lane hF.lok
  -- the records
  have hrec' : ∀ i (hi : i < c.levels.length), RecStored rd σ c i c.levels[i] (rs.getD i default) :=
    fun i hi ↦ by
      have := hrec i (by rw [hrsl]; exact hi) hi
      rw [rs_getD (by rw [hrsl]; exact hi)]
      simpa using this
  have hsta : ∀ i (hi : i < c.levels.length), LvStatic c i c.levels[i] := fun i hi ↦ by
    have := hF.lv i hi; rwa [lv_getD hi] at this
  have hcal' : ∀ i (hi : i < c.levels.length), LvCalleesK rd c i c.levels[i] := fun i hi ↦ by
    simpa using calleesOk_atK hcal i hi
  have hrat' : ∀ i (hi : i < c.levels.length), LvRate σ c i c.levels[i] := fun i hi ↦ by
    simpa using ratesOk_at hrat i hi
  -- the levels' inputs to the finish
  have hTr' : ∀ j (h : j < T.length), LoadHolds rd (σ (.n stT.2)) j T[j] := hTr
  have hbasis : ∀ i (hi : i < c.levels.length), BasisIn rd σ c stT.2 i c.levels[i]
      (βof c rs i * (rs.getD i default).lam ^ c.levels[i].queries) (Xof rs F T i) := fun i hi ↦ by
    have hr := hrec' i hi
    have hs := hsta i hi
    refine ⟨by unfold βof; exact hr.rq.beta, fun t ht ↦ ⟨(vanish_inv hs.vanish t (by
      rw [← hs.pre]; exact ht)).2, ?_⟩⟩
    have hpl : c.levels[i].prefixLen = F.length - (rs.getD i default).F := by
      have := hs.pre; have := hs.cols; rw [hFl, hr.F]; omega
    have hrf : c.levels[i].resFoldOff = (rs.getD i default).F := by rw [hs.rfo, hr.F]
    unfold coordSrc
    rw [hpl, hrf]
    exact load_xof (by rw [hr.F, hFl]; exact hs.le) hfch hTr (by
      rw [hTl, hr.F, hFl]; have := hs.cols; have := hs.pre; omega)
  have hres : ∀ i (hi : i < c.levels.length), ResInK rd σ c i c.levels[i] (Pof rs i)
      ((rs.getD i default).lam) :=
    fun i hi ↦ by
      have hr := hrec' i hi
      have hs := hsta i hi
      exact ⟨(hcal' i hi).res, hrat' i hi, hs.van, hs.posOff, hs.lc, hs.pre,
        fun j hj ↦ hr.rq.pos j hj, hr.rq.lam0, hr.rq.mu⟩
  have hood : OodAll rd σ c stT.2 (Λof rs) (Zof rs) (Yof rs F T) (c.levels.headD default).logCols
      1 c.levels.tail := by
    refine oodAll_of _ _ _ fun i hi ↦ ?_
    have hi' : i + 1 < c.levels.length := by simp at hi; omega
    have hr := hrec' i (by omega)
    have hs := hsta i (by omega)
    have hnf : i ≠ c.yrLevel := by rw [hF.yr]; omega
    have hprev : (if i = 0 then (c.levels.headD default).logCols
        else (c.levels.tail.getD (i - 1) default).logCols) = (c.levels[i]'(by omega)).logCols := by
      rcases i with _ | i
      · simp only [↓reduceIte, List.headD_eq_head?_getD, List.head?_eq_getElem?,
          List.getElem?_eq_getElem (show 0 < c.levels.length by omega), Option.getD_some]
      · simp [List.getD_eq_getElem?_getD, List.getElem?_eq_getElem (show i + 1 < c.levels.length
          by omega)]
    obtain ⟨z, hz⟩ : ∃ z, (rs.getD i default).z = some z := Option.ne_none_iff_exists'.mp
      (hr.z.2.1 hnf)
    obtain ⟨hzl, hzat⟩ := hr.z.2.2 z hz
    have hfo : (c.levels.tail.getD i default).foldsOff = (rs.getD i default).F := by
      have := hF.next i hi'
      rw [List.getD_eq_getElem?_getD, List.getElem?_tail, ← List.getD_eq_getElem?_getD, this,
        lv_getD (by omega), hr.F]
    have hzf : (c.levels[i]'(by omega)).logCols - c.yrLog = F.length - (rs.getD i default).F := by
      have := hs.cols; rw [hFl, hr.F]; omega
    rw [hprev]
    refine ⟨?_, fun t ht ↦ ⟨?_, ?_⟩⟩
    · have := hr.rq.ood hnf
      simp only [Λof, Nat.add_sub_cancel_left]
      rwa [add_comm 1 i]
    · simp only [Zof, Nat.add_sub_cancel_left, hz, Option.getD_some]
      have ht' : t < z.length := by rw [hzl]; have := hs.cols; omega
      rw [List.getD_eq_getElem _ _ ht', add_comm 1 i]
      exact hzat t ht'
    · simp only [Yof, Nat.add_sub_cancel_left, Xof, oodSrc, hzf, hfo]
      exact load_xof (by rw [hr.F, hFl]; exact hs.le) hfch hTr (by
        rw [hTl, hr.F, hFl]; have := hs.cols; omega)
  -- the finish
  obtain ⟨hfin, hpt, hne⟩ := osFinish_soundK (rd := rd) (σ := σ) (c := c) (st := stT.1) (tch := stT.2)
    (ms := ms) (T := T) (Pt := (F ++ T).drop lane ++ (F ++ T).take lane)
    (β := βof c rs) (X := Xof rs F T) (P := Pof rs) (W := Wof rs) (Λ := Λof rs) (Z := Zof rs)
    (Y := Yof rs F T) (Lam := fun i ↦ (rs.getD i default).lam) (fun _ _ ↦ rfl) hfm (by rw [hmsl, hF.ylen]) hfmr hTl hTr
    (ptSrc_ok hFl hTl hF.lane hfch hTr') hbasis hres hood hn hmtT (allOk_mono hle hFin)
  -- the glued weight
  have hlvfin : ∀ i < c.levels.length, LvFin c rs F T i := fun i hi ↦ by
    have hr := hrec' i hi
    have hs := hsta i hi
    refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, hr.z.1, fun h ↦ ?_⟩
    · rw [hr.F, hFl]; exact hs.le
    · rw [lv_getD hi, hFl, hr.F, hTl]; exact hs.cols
    · rw [lv_getD hi]; exact hr.ml
    · rw [lv_getD hi]; exact hr.rq.qlen
    · rw [lv_getD hi]; exact hs.pre
    · rw [lv_getD hi]; exact vanish_val hs.vanish
    · rw [lv_getD hi]; exact fun t ht ↦ (vanish_inv hs.vanish t ht).1
    · rw [lv_getD hi]; exact fun t ht ↦ hne i hi t (by rw [hs.pre]; exact ht)
    · obtain ⟨z, hz⟩ := Option.ne_none_iff_exists'.mp (hr.z.2.1 h)
      exact ⟨z, hz, by rw [lv_getD hi]; exact (hr.z.2.2 z hz).1⟩
  have hinner := inner_eq (rs := rs) (F := F) (T := T) (by rw [hrsl]) (by omega) hF.yr hTl hlvfin
  have hrets := hret.symm.trans hfin
  have hreads : ReadsAt rd cur ([c0, c2] ++ (xs1 ++ (xs2 ++ []))) := by
    refine readsAt_append hrd0 (readsAt_append ?_ (readsAt_append ?_ (readsAt_nil _ _)))
    · rw [show [c0, c2].length = 2 from rfl, ← hcur0]; exact hrd1
    · rw [show [c0, c2].length = 2 from rfl, ← hcur0, ← hcur1]; exact hrd2
  have hxlen : ([c0, c2] ++ (xs1 ++ (xs2 ++ []))).length = osWordsLen c := by
    simp only [List.length_append, List.length_cons, List.length_nil, hxl1, hxl2, osWordsLen]
    omega
  rw [← hxlen, readN_of_readsAt hreads, ← hos1,
    show os1 = [] ++ (os1 ++ ([] ++ [])) by simp]
  refine ⟨⟨(F ++ T).drop lane ++ (F ++ T).take lane, ws'.glued.foldl (fun weight claim ↦
      weight + claim.scalar * claim.weightAt (F.drop claim.foldStart ++ T)) 0,
      multilinearEval ms T, σ (.n stT.1.t)⟩, F', R', ?_, ?_, ?_, σ (.n (stT.1.k + 1)),
    σ (.n (stT.1.k + 1 + 1)), ?_, ?_, ?_⟩
  · exact hreads
  · rw [whirOpen_eq hF.dc hcne target]
    refine RunsWithH.bind (RunsTo.withRootsH (H := keyedHash S) hrun0 _) (RunsWithH.bind hrun1 ?_)
    rw [levelTail_eq, hF.last, hlane']
    exact RunsWithH.bind (RunsTo.withRootsH (H := keyedHash S) hrun2 R') (runsWithH_ret _ _ _)
  · have := hF.lane; have := hF.mu
    simp [hFl, hTl, hF.mu]; omega
  · rw [hrets]
    simp only [hgl, List.nil_append, hinner]
  · have := readsAt_padded (rd := rd) (P := (F ++ T).drop lane ++ (F ++ T).take lane)
      (n := pointCap - μ) id (fun i hi ↦ (hpt i (by
        have := hF.lane; have := hF.mu; have := hF.mu40
        simp [hFl, hTl, hF.mu] at hi; omega)).1)
    simpa using this
  · have := readsAt_padded (rd := rd) (P := (F ++ T).drop lane ++ (F ++ T).take lane)
      (n := pointCap - μ) (fun x ↦ 1 + x) (fun i hi ↦ (hpt i (by
        have := hF.lane; have := hF.mu; have := hF.mu40
        simp [hFl, hTl, hF.mu] at hi; omega)).2)
    rwa [add_zero] at this

theorem calleesOk_ofK {rd : Reader} {c : OsCfg} : ∀ (lvs : List OsLv) (lvl : ℕ),
    (∀ i (hi : i < lvs.length), LvCalleesK rd c (lvl + i) lvs[i]) → CalleesOkK rd c lvl lvs
  | [], _, _ => trivial
  | lv :: rest, lvl, h => ⟨h 0 (by simp), calleesOk_ofK rest (lvl + 1) fun i hi ↦ by
      have := h (i + 1) (by simp; omega)
      rwa [show lvl + (i + 1) = lvl + 1 + i by ring] at this⟩

theorem qwOk_ofK {rd : Reader} {C : CallRel} {Wf : ℕ → OsLv → List E → List E → List QW} :
    ∀ (lvs : List OsLv) (lvl : ℕ),
    (∀ i (hi : i < lvs.length), LvQWK rd C (lvl + i) lvs[i] (Wf (lvl + i) lvs[i])) →
      QWOkK rd C Wf lvl lvs
  | [], _, _ => trivial
  | lv :: rest, lvl, h => ⟨h 0 (by simp), qwOk_ofK rest (lvl + 1) fun i hi ↦ by
      have := h (i + 1) (by simp; omega)
      rwa [show lvl + (i + 1) = lvl + 1 + i by ring] at this⟩

/-- **`open_stacked` is sound with its witness named**, at every size and rate. -/
theorem open_stacked_sound_wK {Wq : OqWit} (hoq : OqSoundK Wq) : open_stacked_sound_w_SpecK Wq := by
  intro κ hκ L C V hU hle S hS2 hS3 μ r h1 h2 h3 h4 root fs target root0 root1 cur rets fn σ hfs hroot hfind
    hp hh
  set rd := L.read
  set m := μ - minOpenLog with hmdef
  set ri := r - 1 with hridef
  have h20 : minOpenLog + ligNSizes = 31 := rfl
  have hm : m < ligNSizes := by omega
  have hri : ri < 4 := by omega
  have hμ : μ = m + minOpenLog := by omega
  have hr : r = ri + 1 := by omega
  obtain ⟨cfg, hF, hnames, hffm⟩ := candB_sound (candB_all m ri hm hri)
  rw [← hμ, ← hr] at hF
  have hdata : FnIsK ("open_stacked__L" ++ natStr m) (osParams 10) (osBody (osCfgR m ri)) := by
    have := osDataK_all m hm
    unfold OsDataK at this
    rwa [osBody_rate m ri] at this
  rw [openName_eq μ hm] at hfind
  have hσ : σ (.n osRate) = ofK (addressOfIndex ri) ∧ σ (.n 9) = cur := by
    obtain ⟨fn0, hf0, hps, -⟩ := hdata
    rw [hf0] at hfind
    cases hfind
    rw [hps] at hp
    obtain ⟨f0, f1, f2, f3, f4, rfl⟩ : ∃ f0 f1 f2 f3 f4, fs = [f0, f1, f2, f3, f4] := by
      match fs, hfs with
      | [f0, f1, f2, f3, f4], _ => exact ⟨f0, f1, f2, f3, f4, rfl⟩
    refine ⟨?_, ?_⟩
    · have := congrArg (·.getD 0 0) hp
      simpa [osParams, rateSel] using this
    · have := congrArg (·.getD 9 0) hp
      simpa [osParams] using this
  set c := osCfgR m ri
  have hW := open_genericK (Wf := Wq rd V) hdata hF
    (calleesOk_ofK _ 0 fun i hi ↦ by
      rw [Nat.zero_add]
      have hn := hnames i hi
      have hs := hF.lv i hi
      rw [lv_getD hi] at hn hs
      exact lvCallees_ofK hκ L hs hn)
    (fun a r h ↦ opening_foldK h)
    (fun a r h ↦ (fold_final_msg_holds _ hffm rd a r).mp (tabSame ffmSame hffm h)) hfs hroot hle hU hS2 hS3
    (qwOk_ofK _ 0 fun i hi ↦ by
      rw [Nat.zero_add]
      have hn := hnames i hi
      rw [lv_getD hi] at hn
      exact hoq rd C V hU hle _ _ _ hn)
    (ratesOk_of _ 0 fun i hi ↦ by
      rw [Nat.zero_add]
      refine ⟨ri, hri, hσ.1, osCfgR_lvAt_length m ri i, ?_⟩
      rw [osCfgR_lvAt_getD i hri, lv_getD hi])
    hfind hp hh
  unfold open_stacked_osWK
  rw [hσ.2, ← hridef]
  have heq : (osQCalls c 0 c.levels (osHead c).2).map (osLevelOsK Wq rd σ V) =
      (osQCalls c 0 c.levels (osHead c).2).map
        (fun e ↦ lvOsK rd σ V (Wq rd V e.1 e.2.1) e.1 e.2.1 e.2.2) := by
    refine List.map_congr_left fun e he ↦ ?_
    obtain ⟨lvl, lv, name, args, rets'⟩ := e
    have := osQCalls_name _ _ _ _ _ he
    simp only at this
    subst this
    rfl
  rw [heq]
  exact hW

end
