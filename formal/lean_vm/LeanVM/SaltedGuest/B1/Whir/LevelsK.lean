/-
  LeanVM.SaltedGuest.B1.Whir.LevelsK

  `open_stacked`'s levels over the salted `level_queries`: they run the Spec's levels at the keyed
  hash. Generated by `scripts/salted-whir/chaincopy.py` from `Guest/B1/Whir/LevelB.lean`,
  `Level.lean` and `Levels.lean`.
-/

module

public import LeanVM.SaltedGuest.B1.Whir.QueriesBlkK
public import LeanVM.SaltedGuest.B1.RunH
public import LeanVM.Guest.B1.Whir.Levels
public import LeanVM.SaltedGuest.B1.Callee
public import LeanVM.SaltedGuest.B1.Whir.OsSame

/-!
# The levels at the keyed hash

The deployed `osLevelB_common`, `levelRest_run`, `osLevelB_sound`, `osLevel_nonfinal_sound`,
`osLevel_final_sound` and `osLevels_sound` (`open_stacked`'s template is unchanged): under a call
relation below the salted core IR's, with the seed `S` of memory words `2` and `3`, the queries
over the salted `level_queries` (`osQueries_soundK`), the runs at `keyedHash S` (`RunsWithH`), the
callees' meanings at the salted core IR (`LvCalleesK`: the cap's `MeaningCapK`, `level_queries`
the salted template `lqBodyK`), the openings read through the salted `level_queries`' call of
`opening_queries` (`lqCallK`).
-/

namespace LeanVM.SaltedGuest.B1.Whir

open LeanVM.Parameters LeanVM.Semantics LeanVM.Guest.Core LeanVM.Guest LeanVM.Guest.B1
open LeanVM.Guest.Value LeanVM.Protocol LeanVM.Protocol.KeccakHash LeanVM.Protocol.Compile
open LeanVM.Protocol.Verifier LeanVM.Guest.B1.Whir LeanVM.SaltedGuest.B1 Recursion.Salted

@[expose] public section

variable {rd : Reader} {σ : Val}

/-- **A query at the hash `H`** consumes one phase: one opening per position, each passing
`openOne` at `H` against commitment `i`'s root; it returns their leaves. -/
theorem runsWithH_queryP {H : Bytes → Digest} (s : Fs) (roots : List (Digest × ℕ × ℕ)) {i : ℕ}
    {root : Digest} {height width : ℕ} (hi : roots[i]? = some (root, height, width)) (ps : List ℕ)
    (os : List Opening) (hl : os.length = ps.length)
    (hok : ∀ k (hk : k < ps.length) (ho : k < os.length),
      Id.run (Compile.openOneWithHash (m := Id) H root height width ps[k] os[k]) = true)
    (hidx : os.map Opening.leafIndex = ps) :
    RunsWithH H (VerifierProgram.queryOpenings i ps) s [] [os] roots (os.map (·.leaf)) s roots := by
  intro sp hs rest orest
  refine ⟨sp, hs, ?_⟩
  have := openPhase_eq_leaves H hl hok hidx
  simp only [Id.run] at this
  simp only [runIdH, VerifierProgram.queryOpenings, Compile.runWithHash, hi, List.nil_append,
      List.cons_append, bind, this]
  rfl

/-- The level's openings over the salted `level_queries`, named by the frames `V` and the queries'
witness `W`. -/
abbrev bOsK (c : OsCfg) (lvl : ℕ) (lv : OsLv) (st : OsSt) (rd : Reader) (σ : Val)
    (V : SaltedGuest.End.FrameMap) (W : List E → List E → List QW) : List Opening :=
  lvOpenings rd (V (osQueriesName lvl lv)
    ((osQueriesDisp c lvl lv (bLam c lvl lv st) (bQs c lvl lv st)).2.1.map σ)
    ((osQueriesDisp c lvl lv (bLam c lvl lv st) (bQs c lvl lv st)).2.2.map σ)) lv W (lqCallK lvl lv)

/-- **A deployed run that opens nothing is a run at any hash.** -/
theorem RunsWith.toH {H : Bytes → Digest} {α : Type} {p : VerifierProgram α} {s s' : Fs}
    {xs : List E} {roots roots' : List (Digest × ℕ × ℕ)} {a : α}
    (h : RunsWith p s xs [] roots a s' roots') : RunsWithH H p s xs [] roots a s' roots' :=
  fun sp hs rest orest ↦ by
    obtain ⟨sp', hs', e⟩ := h sp hs rest orest
    exact ⟨sp', hs', runId_toH e rfl⟩

/-- `opening_fold` is an unchanged function: its deployed meaning holds of its salted calls. -/
theorem opening_foldK {a r : List E} (h : SaltedGuest.coreProgram.Rel rd "opening_fold" a r) :
    MeaningOpeningFold rd a r :=
  (opening_fold_holds rd a r).mp (toD same_opening_fold.1 same_opening_fold.2 h)

/-- The callees of a level's queries, at the rate's row `lv`: `level_positions`,
`level_queries`'s template, the row weights and the cap. -/
structure LvQCalleesK (rd : Reader) (lvl : ℕ) (lv : OsLv) : Prop where
  lp : ∀ args rets, SaltedGuest.coreProgram.Rel rd (osPositionsName lv) args rets →
    WinTabs rd (args.getD 7 0) → MeaningLevelPositions lv.depth lv.capDepth lv.squeezes rd args rets
  lq : FnIsK (osQueriesName lvl lv) (osParams 3)
    (lqBodyK lv.queries (if lvl = 0 then 1 else 0) lv.interleave lv.leafCells lv.depth lv.capDepth)
  rw : ∀ args rets, SaltedGuest.coreProgram.Rel rd ("opening_row_weights__L" ++ natStr lv.folds ++ "_L" ++
    natStr (if lvl = 0 then 1 else 0)) args rets →
      MeaningOpeningRowWeights lv.folds (if lvl = 0 then 1 else 0) rd args rets
  cap : ∀ args rets, SaltedGuest.coreProgram.Rel rd ("verify_merkle_cap__L" ++ natStr lv.capDepth) args rets →
    MeaningCapK (2 ^ lv.capDepth) rd args rets

/-- The positions, `μ` and the queries of a level. -/
theorem osLevelB_commonK {C : CallRel} (hle : CallRel.Le C (SaltedGuest.coreProgram.Rel rd)) {V : SaltedGuest.End.FrameMap}
    (hU : SaltedGuest.End.UnfoldsV rd C V)
    {S : Digest} (hS2 : LoadHolds rd 1 2 (digestHalves S).1)
    (hS3 : LoadHolds rd 1 3 (digestHalves S).2) {c : OsCfg}
    {lvl : ℕ} {lv : OsLv} {st : OsSt} {level : Whir.Level}
    {ml : ℕ} (hcfg : LvB c lvl lv level ml)
    (hsq : AllOk C rd σ (osPositions c lvl lv st).1)
    (hmu : AllOk C rd σ (bMu c lvl lv st).1)
    (hq : AllOk C rd σ (bQ c lvl lv st).1)
    (hcal : LvQCalleesK rd lvl lv) (hrate : LvRate σ c lvl lv)
    (hwt : WinTabs rd (σ (.n osWin)))
    (W : List E → List E → List QW) (hQW : LvQWK rd C lvl lv W)
    (hfs : st.fs.length = 5) (hpad : PadOk σ st.pad) (hmats : MatsOk σ st.mats)
    {lf : List E} (hlf : lf.length = lv.folds)
    (hfch : ∀ j < lv.folds, LoadHolds rd (σ (.n osFch)) (lv.foldsOff + j) (lf.getD j 0))
    {root : Digest}
    (hr0 : LoadHolds rd (σ (.n osRoots)) (2 * lvl) (digestHalves root).1)
    (hr1 : LoadHolds rd (σ (.n osRoots)) (2 * lvl + 1) (digestHalves root).2) :
    let F2 : Fs := ⟨st.fsv σ, []⟩
    let qs := queriesOf (192 / lv.depth) lv.depth (F2.squeezeN lv.squeezes).1 lv.queries
    σ (.n (bLam c lvl lv st)) = (F2.squeezeN lv.squeezes).2.squeeze.1 ∧
    (bSq c lvl lv st).fsv σ = (F2.squeezeN lv.squeezes).2.squeeze.2.cap ∧
    PadOk σ (bSq c lvl lv st).pad ∧ (bSq c lvl lv st).fs.length = 5 ∧
    qs.length = lv.queries ∧ (∀ k < lv.queries, qs.getD k 0 < 2 ^ lv.depth) ∧
    (∀ k < lv.queries, LoadHolds rd (σ (.n osQpos)) (lv.posOff + k) (eOfNat (qs.getD k 0))) ∧
    σ (.n (bLamN c lvl lv st)) = σ (.n (bLam c lvl lv st)) ^ lv.queries ∧
    σ (.n (bLam c lvl lv st)) ≠ 0 ∧
    LoadHolds rd (σ (.n osMus)) lvl (σ (.n (bLam c lvl lv st)))⁻¹ ∧
    MatsOk σ (bS1 c lvl lv st).mats ∧
    ∃ (os : List Opening) (ic0 ic2 : E), os = bOsK c lvl lv st rd σ V W ∧ os.length = lv.queries ∧
      (∀ k (hk : k < qs.length) (ho : k < os.length),
        Id.run (Compile.openOneWithHash (m := Id) (keyedHash S) root lv.depth
          (if lvl = 0 then lv.interleave else 3 * lv.interleave) qs[k] os[k]) = true) ∧
      σ (.n (bQ c lvl lv st).2.2.1) = enforcedSum ((os.map (·.leaf)).map (specRow lvl)) lf
        (powers (σ (.n (bLam c lvl lv st))) lv.queries) ∧
      ReadsAt rd (st.cur σ) [ic0, ic2] ∧ σ (.n (bQ c lvl lv st).2.2.2.2.1) = ic0 ∧
      σ (.n (bQ c lvl lv st).2.2.2.2.2.2) = ic2 ∧
      σ (.n (bQ c lvl lv st).2.2.2.2.2.1) = σ (.n (bQ c lvl lv st).2.2.1) + ic2 ∧
      os.map Opening.leafIndex = qs := by
  intro F2 qs
  obtain ⟨hdepth, hqq, hq2, hqd, hper, hsqz, hdig, hpo, hsq0, hsqo, hsq5, hrow, hcd, hcd8, hcdd,
    hbo⟩ := hcfg
  obtain ⟨D, hlam, hfsv, hpad', hfs', hmsq⟩ :=
    osPositions_sound hsq (fun a r h hw ↦ hcal.lp a r (hle _ _ _ h) hw)
      hrate hwt hpo hfs hpad hmats
  obtain ⟨hl0, hmu'⟩ := osMu_sound hmu
  have hdec' : ∀ jj < lv.squeezes, MeaningDecodeQueryWindows lv.depth lv.capDepth rd
      [(F2.squeezeN lv.squeezes).1.getD jj 0,
        σ (.n osQpos) * gen ^ (lv.posOff + jj * (192 / lv.depth)),
        σ (.n osQbp) * gen ^ (lv.posOff + jj * (192 / lv.depth)), σ (.n osWin)] [] := by
    intro jj hjj
    rw [squeezeN_getD _ _ _ hjj]
    exact D jj hjj
  have hqle : lv.queries ≤ lv.squeezes * (192 / lv.depth) := by
    rw [hsqz]; exact le_ceilDiv_mul hper
  have tab := positions_of_decodes hper hqle _ hdec'
  have hqlt : ∀ k < lv.queries, qs.getD k 0 < 2 ^ lv.depth := by
    intro k hk
    simp only [qs, queriesOf, List.getD_eq_getElem?_getD, List.getElem?_map, List.getElem?_range hk,
      Option.map_some, Option.getD_some]
    exact Nat.mod_lt _ (by positivity)
  obtain ⟨ic0, ic2, hol, hop, hsum, hlamN, hrd, e0, e2, e1, hmq, hidx⟩ :=
    osQueries_soundK hle hU hq (by simpa using hmsq) hrate hcal.lq hqd hrow hcd hcd8 hcdd hcal.rw
      hcal.cap W hQW hS2 hS3 hlf hfch hr0 hr1 qs (by simp [qs, queriesOf]) hqlt (fun k hk ↦ (tab k hk).2) hbo
  refine ⟨hlam, hfsv, hpad', hfs', by simp [qs, queriesOf], hqlt, fun k hk ↦ (tab k hk).1, hlamN,
    hl0, hmu', hmq, _, ic0, ic2, rfl, hol, hop, hsum, ?_, e0, e2, e1, hidx⟩
  exact hrd

/-- **The Spec's `levelRest`** from a sponge with nothing waiting: the positions of `nsq`
squeezes, the batching challenge, the openings, the intro's two words. -/
theorem levelRest_runK {S : Digest} {ml lvl : ℕ} {level : Whir.Level} {lf : List E} {ws : WhirStateT}
    {pending : List (E × List E × (List E → E))} {F : Fs} {d nsq : ℕ}
    (hd : ml + level.logInvRate = d) (hper : 1 ≤ 192 / d)
    (hn : nsq = ceilDiv level.queries (192 / d)) {R : List (Digest × ℕ × ℕ)} {root : Digest}
    {height width : ℕ} (hR : R[lvl]? = some (root, height, width)) (os : List Opening)
    (hol : os.length = (queriesOf (192 / d) d (F.squeezeN nsq).1 level.queries).length)
    (hop : ∀ k (hk : k < (queriesOf (192 / d) d (F.squeezeN nsq).1 level.queries).length)
      (ho : k < os.length), Id.run (Compile.openOneWithHash (m := Id) (keyedHash S) root height width
        (queriesOf (192 / d) d (F.squeezeN nsq).1 level.queries)[k] os[k]) = true)
    (hidx : os.map Opening.leafIndex = queriesOf (192 / d) d (F.squeezeN nsq).1 level.queries)
    (ic0 ic2 : E) :
    let qs := queriesOf (192 / d) d (F.squeezeN nsq).1 level.queries
    let lam := (F.squeezeN nsq).2.squeeze.1
    let enf := enforcedSum ((os.map (·.leaf)).map (specRow lvl)) lf (powers lam qs.length)
    RunsWithH (keyedHash S) (levelRest ml lvl level lf ws pending) F [ic0, ic2] [os] R
      (glueT lam ws (pending ++ [(enf, [ic0, enf + ic2, ic2],
        fun x ↦ inducedWeight ml qs (powers lam qs.length) x)]))
      ⟨(F.squeezeN nsq).2.squeeze.2.cap, [(ic0, dsObserve), (ic2, dsObserve)]⟩ R := by
  subst hn
  intro qs lam enf
  have h1 : RunsWithH (keyedHash S) (sampleQueries (ml + level.logInvRate) level.queries) F [] [] R qs
      (F.squeezeN (ceilDiv level.queries (192 / d))).2 R := by
    rw [hd]
    unfold sampleQueries
    exact RunsTo.withRootsH
      (sampleQueriesAux_run d hper level.queries level.queries F (ceilDiv_le hper)) R
  set nsq := ceilDiv level.queries (192 / d)
  have h2 := RunsTo.withRootsH (H := keyedHash S) (runsTo_sampleE (F.squeezeN nsq).2) R
  have h3 := runsWithH_queryP (F.squeezeN nsq).2.squeeze.2 R hR qs os hol hop hidx
  have h4 := RunsTo.withRootsH (H := keyedHash S) (runsTo_round3 (F.squeezeN nsq).2.squeeze.2 enf ic0 ic2) R
  have hF4 : (((F.squeezeN nsq).2.squeeze.2.absorb ic0 dsObserve).absorbAll [ic2] dsObserve) =
      ⟨(F.squeezeN nsq).2.squeeze.2.cap, [(ic0, dsObserve), (ic2, dsObserve)]⟩ := by
    simp [Fs.absorbAll, Fs.absorb, Fs.squeeze, rateScalars]
  rw [hF4] at h4
  have e : levelRest ml lvl level lf ws pending =
      (sampleQueries (ml + level.logInvRate) level.queries).bind fun queries ↦
        VerifierProgram.sampleChallenge.bind fun lam ↦ (VerifierProgram.queryOpenings lvl
            queries).bind fun words ↦
          (sumcheckRoundPoly 3 (enforcedSum (words.map (specRow lvl)) lf
            (powers lam queries.length)) none).bind fun intro ↦
            VerifierProgram.ret (glueT lam ws (pending ++ [(enforcedSum (words.map (specRow lvl)) lf
              (powers lam queries.length), intro,
              fun x ↦ inducedWeight ml queries (powers lam queries.length) x)])) := by
    simp only [levelRest, specRows_eq, VerifierProgram.bind_eq, VerifierProgram.pure_eq]
  rw [e]
  refine RunsWithH.of_eq (RunsWithH.bind h1 (RunsWithH.bind h2 (RunsWithH.bind h3 (RunsWithH.bind h4
    (runsWithH_ret _ _ _))))) rfl (by simp) (by simp) rfl rfl rfl rfl

/-- **A level's queries and glue.** -/
theorem osLevelB_soundK {C : CallRel} (hle : CallRel.Le C (SaltedGuest.coreProgram.Rel rd)) {V : SaltedGuest.End.FrameMap}
    (hU : SaltedGuest.End.UnfoldsV rd C V)
    {S : Digest} (hS2 : LoadHolds rd 1 2 (digestHalves S).1)
    (hS3 : LoadHolds rd 1 3 (digestHalves S).2) {c : OsCfg}
    {lvl : ℕ} {lv : OsLv} {st : OsSt} {level : Whir.Level}
    {ml : ℕ} (hcfg : LvB c lvl lv level ml)
    (hok : AllOk C rd σ (osLevelB c lvl lv st).1)
    (hcal : LvQCalleesK rd lvl lv) (hrate : LvRate σ c lvl lv)
    (hwt : WinTabs rd (σ (.n osWin)))
    (W : List E → List E → List QW) (hQW : LvQWK rd C lvl lv W)
    (hfs : st.fs.length = 5) (hpad : PadOk σ st.pad) (hmats : MatsOk σ st.mats)
    {ws : WhirStateT} (hquad : ws.quad = st.quad σ) (ht : ws.target = σ (.n st.t))
    {lf : List E} (hlf : lf.length = lv.folds)
    (hfch : ∀ j < lv.folds, LoadHolds rd (σ (.n osFch)) (lv.foldsOff + j) (lf.getD j 0))
    {R : List (Digest × ℕ × ℕ)} {root : Digest}
    (hR : R[lvl]? = some (root, lv.depth, if lvl = 0 then lv.interleave else 3 * lv.interleave))
    (hr0 : LoadHolds rd (σ (.n osRoots)) (2 * lvl) (digestHalves root).1)
    (hr1 : LoadHolds rd (σ (.n osRoots)) (2 * lvl + 1) (digestHalves root).2)
    {pending : List (E × List E × (List E → E))} (hpend : PendOk rd σ c lvl pending) :
    ∃ (xs : List E) (os : List Opening) (ws' : WhirStateT) (lam : E) (qs : List ℕ),
      os = bOsK c lvl lv st rd σ V W ∧ ReadsAt rd (st.cur σ) xs ∧ xs.length = 2 ∧
      RunsWithH (keyedHash S) (levelRest ml lvl level lf ws pending) ⟨st.fsv σ, []⟩ xs [os] R ws'
        ((osLevelB c lvl lv st).2.F σ) R ∧
      ws'.quad = (osLevelB c lvl lv st).2.quad σ ∧ ws'.target = σ (.n (osLevelB c lvl lv st).2.t) ∧
      (∃ (enf : E) (intro : List E), ws' = glueT lam ws (pending ++
        [(enf, intro, fun x ↦ inducedWeight ml qs (powers lam qs.length) x)])) ∧
      LvRec rd σ c lvl lv lam qs ∧
      (osLevelB c lvl lv st).2.fs.length = 5 ∧ PadOk σ (osLevelB c lvl lv st).2.pad ∧
      (osLevelB c lvl lv st).2.cb = st.cb ∧ (osLevelB c lvl lv st).2.co = st.co + 2 ∧
      MatsOk σ (osLevelB c lvl lv st).2.mats := by
  have hsqc : (bSq c lvl lv st).c = st.c ∧ (bSq c lvl lv st).b = st.b ∧
      (bSq c lvl lv st).a = st.a ∧ (bSq c lvl lv st).t = st.t ∧ (bSq c lvl lv st).cb = st.cb ∧
      (bSq c lvl lv st).co = st.co := ⟨rfl, rfl, rfl, rfl, rfl, rfl⟩
  rw [osLevelB_eq] at hok ⊢
  by_cases hfin : lvl = c.yrLevel
  · have hc : (lvl = c.yrLevel) = True := eq_true hfin
    simp only [hc, ↓reduceIte] at hok ⊢
    simp only [allOk_append, allOk_cons, allOk_nil, and_true, Whir.StmtOk, Atom.Holds] at hok
    obtain ⟨⟨⟨⟨hsq, hmu⟩, hq⟩, hbm, hbeta⟩, hgl⟩ := hok
    have hpend' : pending = [] := by
      have := hpend; unfold PendOk at this; simpa only [hc, ↓reduceIte] using this
    subst hpend'
    obtain ⟨hlam, hfsv, hpad', hfs', hqlen, hqlt, hpos, hlamN, hl0, hmu, hmq, os, ic0, ic2, hos, hol,
      hop, hsum, hrd, e0, e2, e1, hidx⟩ := osLevelB_commonK hle hU hS2 hS3 hcfg hsq hmu
      hq hcal hrate hwt W hQW hfs hpad hmats hlf hfch hr0 hr1
    obtain ⟨gq, gt⟩ := osGlue_sound hgl
    rw [hbm, hlamN] at hbeta
    have hd := hcfg.depth.symm
    have hqq := hcfg.queries
    have hrun := levelRest_runK (F := ⟨st.fsv σ, []⟩) (ws := ws) (lf := lf) (pending := [])
      (nsq := lv.squeezes) hd hcfg.per (by rw [hqq]; exact hcfg.squeezes) hR os
      (by simp [hol, hqq, queriesOf]) (by rw [hqq]; exact hop) (by rw [hqq]; exact hidx) ic0 ic2
    rw [hqq] at hrun
    have hql : (queriesOf (192 / lv.depth) lv.depth
        (Fs.squeezeN lv.squeezes ⟨st.fsv σ, []⟩).1 lv.queries).length = lv.queries := by
      simp [queriesOf]
    refine ⟨_, os, _, _, _, hos, hrd, rfl, RunsWithH.of_eq hrun rfl rfl rfl rfl rfl ?_ rfl, ?_, ?_,
      ⟨_, _, rfl⟩, ⟨hqlen, hqlt, hpos, by rw [← hlam]; exact hl0, by rw [← hlam]; exact hmu,
        by simp only [hc, ↓reduceIte]; rw [← hlam]; exact hbeta, fun h ↦ absurd hfin h⟩, hfs',
      hpad', rfl, rfl, hmq⟩
    · show _ = (⟨(bSq c lvl lv st).fsv σ, [(σ (.n (bQ c lvl lv st).2.2.2.2.1), dsObserve),
        (σ (.n (bQ c lvl lv st).2.2.2.2.2.2), dsObserve)]⟩ : Fs)
      rw [hfsv, e0, e2]
    · rw [gq, hql]
      simp only [List.nil_append, glue_one, hquad, OsSt.quad, List.zipWith_cons_cons,
        List.zipWith_nil_left, one_mul]
      rw [e0, e1, e2, hsum, hlam]
      simp only [hsqc.1, hsqc.2.1, hsqc.2.2.1]
    · rw [gt, hql]
      simp only [List.nil_append, glue_one, ht, one_mul]
      rw [hsum, hlam]
      simp only [hsqc.2.2.2.1]
  · have hc : (lvl = c.yrLevel) = False := eq_false hfin
    simp only [hc, ↓reduceIte] at hok ⊢
    simp only [allOk_append, allOk_cons, allOk_nil, and_true, Whir.StmtOk, Atom.Holds] at hok
    obtain ⟨⟨⟨⟨⟨hsq, hmu⟩, hq⟩, hog⟩, hbm, hbeta⟩, hgl⟩ := hok
    obtain ⟨y, c0, c2, z, hpe, hy, hc0, hc2⟩ : ∃ (y c0 c2 : E) (z : List E),
        pending = [(y, [c0, y + c2, c2], fun x ↦ eqEval z x)] ∧
        LoadHolds rd (σ (.n osOod)) ((lvl + 1) * oodSlots + 1) y ∧
        LoadHolds rd (σ (.n osOod)) ((lvl + 1) * oodSlots + 2) c0 ∧
        LoadHolds rd (σ (.n osOod)) ((lvl + 1) * oodSlots + 3) c2 := by
      have := hpend; unfold PendOk at this; simpa only [hc, ↓reduceIte] using this
    subst hpe
    obtain ⟨hlam, hfsv, hpad', hfs', hqlen, hqlt, hpos, hlamN, hl0, hmu, hmq, os, ic0, ic2, hos, hol,
      hop, hsum, hrd, e0, e2, e1, hidx⟩ := osLevelB_commonK hle hU hS2 hS3 hcfg hsq hmu
      hq hcal hrate hwt W hQW hfs hpad hmats hlf hfch hr0 hr1
    obtain ⟨y', c0', c2', hy', hc0', hc2', hlo, oq, ot, ob⟩ := osOodGlue_sound hog
    rw [hbm, hlamN] at hbeta
    rw [loadHolds_unique hy' hy] at oq ot
    rw [loadHolds_unique hc0' hc0] at oq
    rw [loadHolds_unique hc2' hc2] at oq
    obtain ⟨gq, gt⟩ := osGlue_sound hgl
    simp only [OsSt.quad, List.cons.injEq, and_true] at oq
    obtain ⟨oc, obb, oa⟩ := oq
    have hd := hcfg.depth.symm
    have hqq := hcfg.queries
    have hrun := levelRest_runK (F := ⟨st.fsv σ, []⟩) (ws := ws) (lf := lf)
      (pending := [(y, [c0, y + c2, c2], fun x ↦ eqEval z x)])
      (nsq := lv.squeezes) hd hcfg.per (by rw [hqq]; exact hcfg.squeezes) hR os
      (by simp [hol, hqq, queriesOf]) (by rw [hqq]; exact hop) (by rw [hqq]; exact hidx) ic0 ic2
    rw [hqq] at hrun
    have hql : (queriesOf (192 / lv.depth) lv.depth
        (Fs.squeezeN lv.squeezes ⟨st.fsv σ, []⟩).1 lv.queries).length = lv.queries := by
      simp [queriesOf]
    refine ⟨_, os, _, _, _, hos, hrd, rfl, RunsWithH.of_eq hrun rfl rfl rfl rfl rfl ?_ rfl, ?_, ?_,
      ⟨_, _, rfl⟩, ⟨hqlen, hqlt, hpos, by rw [← hlam]; exact hl0, by rw [← hlam]; exact hmu,
        by simp only [hc, ↓reduceIte]; rw [← hlam, ← ob]; exact hbeta,
        fun _ ↦ by rw [← hlam]; exact hlo⟩, hfs', hpad', rfl, rfl, hmq⟩
    · show _ = (⟨(bSq c lvl lv st).fsv σ, [(σ (.n (bQ c lvl lv st).2.2.2.2.1), dsObserve),
        (σ (.n (bQ c lvl lv st).2.2.2.2.2.2), dsObserve)]⟩ : Fs)
      rw [hfsv, e0, e2]
    · rw [gq, hql]
      simp only [List.singleton_append, glue_two, hquad, OsSt.quad, List.zipWith_cons_cons,
        List.zipWith_nil_left, one_mul]
      rw [oc, obb, oa, ob, e0, e1, e2, hsum, hlam]
      simp only [hsqc.1, hsqc.2.1, hsqc.2.2.1]
    · rw [gt, ot, hql]
      simp only [List.singleton_append, glue_two, ht, one_mul]
      rw [ob, hsum, hlam]
      simp only [hsqc.2.2.2.1]

/-- The callees a level's template calls, by their meanings, at the rate's row `lv`. -/
structure LvCalleesK (rd : Reader) (c : OsCfg) (lvl : ℕ) (lv : OsLv) : Prop where
  can : ∀ args rets, SaltedGuest.coreProgram.Rel rd "assert_canonical" args rets →
    MeaningAssertCanonical args rets
  ood : lvl ≠ c.yrLevel → ∀ args rets,
    SaltedGuest.coreProgram.Rel rd ("opening_ood_point__L" ++ natStr lv.logCols) args rets →
      MeaningOpeningOodPoint lv.logCols rd args rets
  fm : ∀ args rets, SaltedGuest.coreProgram.Rel rd ("opening_final_message__L" ++ natStr c.yrLen) args rets →
    MeaningOpeningFinalMessage c.yrLen rd args rets
  grind : ∀ args rets, SaltedGuest.coreProgram.Rel rd ("grind_check__L" ++ natStr lv.grind) args rets →
    MeaningGrindCheck Whir.queryGrindingBits args rets
  q : LvQCalleesK rd lvl lv
  res : ∀ args rets, SaltedGuest.coreProgram.Rel rd (osResidualName lv) args rets →
    MeaningLevelResidual lv.queries lv.logCols rd args rets

/-- A level's openings from its `level_queries` dispatch `call` (words values of `σ`): those of the
`opening_queries` call in the callee's frame `V`, its queries' witness `W`. -/
def lvOsK (rd : Reader) (σ : Val) (V : SaltedGuest.End.FrameMap) (W : List E → List E → List QW) (lvl : ℕ)
    (lv : OsLv) (call : String × List Core.V × List Core.V) : List Opening :=
  lvOpenings rd (V call.1 (call.2.1.map σ) (call.2.2.map σ)) lv W (lqCallK lvl lv)

/-- **A level that is not the last.** -/
theorem osLevel_nonfinal_soundK {c : OsCfg} {lvl : ℕ} {lv lv' : OsLv} {logN : ℕ}
    {level next : Whir.Level} {rest : List Whir.Level}
    {C : CallRel} (hle : CallRel.Le C (SaltedGuest.coreProgram.Rel rd)) {V : SaltedGuest.End.FrameMap} (hU : SaltedGuest.End.UnfoldsV rd C V)
    {S : Digest} (hS2 : LoadHolds rd 1 2 (digestHalves S).1)
    (hS3 : LoadHolds rd 1 3 (digestHalves S).2)
    {W : List E → List E → List QW} (hQW : LvQWK rd C lvl lv W)
    (hcb : LvCalleesK rd c lvl lv) (hrate : LvRate σ c lvl lv) (hcfg : LvB c lvl lv level lv.logCols)
    (hfold : level.fold = lv.folds) (h4 : 1 ≤ lv.folds)
    (hml : logN - (lv.foldsOff + lv.folds) = lv.logCols) (hm : 1 ≤ lv.logCols)
    (hlvl : (lvl + 1) * ligColsCap < u128Bound) (hnf : lvl ≠ c.yrLevel)
    (hoff' : lv'.foldsOff = lv.foldsOff + lv.folds)
    (hshape : levelShape lv.logCols next (3 * 2 ^ next.fold) = (lv'.depth, lvWidth (lvl + 1) lv'))
    {st : OsSt} {ws : WhirStateT} {R : List (Digest × ℕ × ℕ)} {root : Digest}
    (hin : LvIn rd σ lvl lv st ws R root) (hwt : WinTabs rd (σ (.n osWin)))
    (hok : AllOk C rd σ (osLevel c lvl lv st).1) :
    ∃ (xs : List E) (os : List Opening) (ws' : WhirStateT) (root' : Digest) (r : OsRec),
      ReadsAt rd (st.cur σ) xs ∧
      RunsWithH (keyedHash S) (levelHead logN lvl level (next :: rest) ws) (st.F σ) xs [os] R
        ([], lv.logCols, ws') ((osLevel c lvl lv st).2.F σ) (R ++ [(root', lv'.depth, lvWidth (lvl + 1) lv')]) ∧
      LvIn rd σ (lvl + 1) lv' (osLevel c lvl lv st).2 ws' (R ++ [(root', lv'.depth, lvWidth (lvl + 1) lv')])
        root' ∧
      ws'.glued = ws.glued ++ recClaims r ∧ RecStored rd σ c lvl lv r ∧
      (osLevel c lvl lv st).2.cur σ = st.cur σ * gen ^ xs.length ∧
      os = lvOsK rd σ V W lvl lv (osQCall c lvl lv st) ∧
      xs.length = 2 * lv.folds + 6 + 2 := by
  have hc : (lvl = c.yrLevel) = False := eq_false hnf
  rw [osLevel_split] at hok ⊢
  rw [allOk_append] at hok
  obtain ⟨hA, hB⟩ := hok
  simp only [osLevelA, hc, ↓reduceIte] at hA hB ⊢
  rw [allOk_append, allOk_append] at hA
  obtain ⟨⟨hF, hC⟩, hG⟩ := hA
  -- the folds
  obtain ⟨xs1, chs, hx1, hcl, hrd1, hrun1, hcur1, hfs1, hco1, hch⟩ :=
    osFolds_sound (fun _ _ h ↦ opening_foldK (hle _ _ _ h)) osFch lv.folds
      lv.foldsOff st ws [] hin.fs (by have := hin.co; unfold u128Bound; omega) hin.quad hin.t hF
  set st1 := (osFolds osFch lv.foldsOff lv.folds st).2
  have hco1' : st1.co = 0 := hco1.resolve_left (by omega)
  -- the commitment
  obtain ⟨ra, rb, y, c0, c2, nonce, d, z, F', hrd2, hco, hrun2⟩ :=
    osCommit_sound hcb.can (hcb.ood hnf) hcb.grind hfs1
      (by rw [osFolds_mats]; exact hin.mats) hm hlvl
      (allOk_mono hle (allOk_append.mpr ⟨hC, hG⟩)) next rest R
  set st2 := (osCommit c.plan lvl lv st1).2.1
  have hpad2 : st2.pad = st.pad := (osFolds_state' osFch lv.folds lv.foldsOff st).1
  have hR2 : (R ++ [(d, levelShape lv.logCols next (3 * 2 ^ next.fold))])[lvl]? =
      some (root, lv.depth, if lvl = 0 then lv.interleave else 3 * lv.interleave) := by
    rw [List.getElem?_append_left (by rw [hin.rlen]; omega)]
    exact hin.R
  obtain ⟨xs3, os, ws', lam, qs, hos, hrd3, hxl3, hrun3, hq3, ht3, ⟨enf, intro, hws'⟩, hrec, hfs3, hpad3,
      hcb3, hco3, hmats3⟩ :=
    osLevelB_soundK hle (lf := [] ++ chs) (ws := { ws with
        target := σ (.n st1.t)
        quad := st1.quad σ
        folds := ws.folds ++ chs })
      (pending := [(y, [c0, y + c2, c2], fun x ↦ eqEval z x)])
      hU hS2 hS3 hcfg hB hcb.q hrate hwt W hQW hco.fs (by rw [hpad2]; exact hin.pad) hco.mats
      rfl rfl (by simpa using hcl) (fun j hj ↦ by
        have := hch j (by rw [hcl]; exact hj)
        rw [List.nil_append, List.getD_eq_getElem _ _ (by rw [hcl]; exact hj)]
        exact this) hR2 hin.r0 hin.r1
      (by unfold PendOk; simp only [hc, ↓reduceIte]
          exact ⟨y, c0, c2, z, rfl, hco.oy, hco.oc0, hco.oc2⟩)
  have hfl : (ws.folds ++ chs).length = lv.foldsOff + lv.folds := by
    rw [List.length_append, hin.folds, hcl]
  have hml' : logN - (ws.folds ++ chs).length = lv.logCols := by rw [hfl, hml]
  rw [List.singleton_append, glue_two] at hws'
  have hwf : ws'.folds = ws.folds ++ chs := by rw [hws']
  have hwg : ws'.glued = ws.glued ++ [⟨1 * lam, (ws.folds ++ chs).length, fun x ↦ eqEval z x⟩,
      ⟨1 * lam * lam, (ws.folds ++ chs).length,
        fun x ↦ inducedWeight lv.logCols qs (powers lam qs.length) x⟩] := by rw [hws']
  rw [levelHead_eq]
  have r1 := RunsTo.withRootsH (H := keyedHash S) hrun1 R
  rw [← hfold] at r1
  have r2 : RunsWithH (keyedHash S) (do
        let r ← levelMid (logN - (ws.folds ++ chs).length) (next :: rest)
        VerifierProgram.grindProofOfWork Whir.queryGrindingBits
        pure r) (st1.F σ) [ra, rb, y, c0, c2, nonce] [] R
      ([], [(y, [c0, y + c2, c2], fun x ↦ eqEval z x)]) F'
      (R ++ [(d, levelShape lv.logCols next (3 * 2 ^ next.fold))]) := by
    rw [hml']; exact RunsWith.toH hrun2
  have r3 : RunsWithH (keyedHash S) (levelRest (logN - (ws.folds ++ chs).length) lvl level ([] ++ chs)
      { ws with
        target := σ (.n st1.t)
        quad := st1.quad σ
        folds := ws.folds ++ chs }
      [(y, [c0, y + c2, c2], fun x ↦ eqEval z x)]) F' xs3 [os]
      (R ++ [(d, levelShape lv.logCols next (3 * 2 ^ next.fold))]) ws'
      ((osLevelB c lvl lv st2).2.F σ)
      (R ++ [(d, levelShape lv.logCols next (3 * 2 ^ next.fold))]) := by
    rw [hml', hco.sponge]; exact hrun3
  refine ⟨xs1 ++ ([ra, rb, y, c0, c2, nonce] ++ (xs3 ++ [])), os, ws', d,
    ⟨lam, qs, some z, lv.foldsOff + lv.folds, lv.logCols⟩, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · refine readsAt_append hrd1 (readsAt_append ?_ ?_)
    · rw [hx1, ← hcur1]; exact hrd2
    · rw [List.append_nil, hx1, ← hcur1, show [ra, rb, y, c0, c2, nonce].length = 6 from rfl,
        ← hco.cur]
      exact hrd3
  · refine RunsWithH.of_eq (RunsWithH.bind r1 (RunsWithH.bind r2 (RunsWithH.bind r3
      (runsWithH_ret _ _ _)))) rfl rfl rfl rfl ?_ rfl ?_
    · simp only [hml']
    · rw [hshape]
  · refine ⟨hfs3, ?_, hpad3, hq3, ht3, ?_, ?_, by simp [hin.rlen], ?_, ?_, ?_, hmats3⟩
    · rw [hco3]; simp [st2, osCommit, hco1']
    · rw [hwf, hfl, hoff']
    · intro j hj
      simp only [hwf] at hj ⊢
      rcases Nat.lt_or_ge j ws.folds.length with h | h
      · rw [List.getElem_append_left h]; exact hin.fch j h
      · rw [List.getElem_append_right h]
        have := hch (j - ws.folds.length) (by simp at hj; omega)
        have e : lv.foldsOff + (j - ws.folds.length) = j := by rw [← hin.folds]; omega
        rwa [e] at this
    · simp [hin.rlen]
    · rw [← hco.root, show 2 * (lvl + 1) = 2 * lvl + 2 by ring]; exact hco.rootA
    · rw [← hco.root, show 2 * (lvl + 1) + 1 = 2 * lvl + 3 by ring]; exact hco.rootB
  · rw [hwg, hfl]; rfl
  · exact ⟨hrec, ⟨fun h ↦ absurd h hnf, fun _ ↦ by simp, fun z' hz ↦ by
      cases hz; exact ⟨hco.zlen, hco.zat⟩⟩, rfl, rfl⟩
  · simp only [OsSt.cur, hcb3, hco3, List.length_append, List.length_cons, List.length_nil, hxl3]
    have := hco.cur
    simp only [OsSt.cur] at this hcur1
    rw [pow_add, ← mul_assoc, this, hcur1, hx1]
    ring
  · rw [hos]
    simp only [bOsK, lvOsK, osQCall, hc, ↓reduceIte]
    rfl
  · simp only [List.length_append, hx1, hxl3, List.length_cons, List.length_nil]

/-- **The last level**: it runs its head, reads the final message (the residual, stored in
`final_msg`). -/
theorem osLevel_final_soundK {c : OsCfg} {lvl : ℕ} {lv : OsLv} {logN : ℕ} {level : Whir.Level}
    {C : CallRel} (hle : CallRel.Le C (SaltedGuest.coreProgram.Rel rd)) {V : SaltedGuest.End.FrameMap} (hU : SaltedGuest.End.UnfoldsV rd C V)
    {S : Digest} (hS2 : LoadHolds rd 1 2 (digestHalves S).1)
    (hS3 : LoadHolds rd 1 3 (digestHalves S).2)
    {W : List E → List E → List QW} (hQW : LvQWK rd C lvl lv W)
    (hcb : LvCalleesK rd c lvl lv) (hrate : LvRate σ c lvl lv) (hcfg : LvB c lvl lv level lv.logCols)
    (hfold : level.fold = lv.folds) (h4 : 1 ≤ lv.folds)
    (hml : logN - (lv.foldsOff + lv.folds) = lv.logCols) (hlen : 2 ^ lv.logCols = c.yrLen)
    (hfin : lvl = c.yrLevel)
    {st : OsSt} {ws : WhirStateT} {R : List (Digest × ℕ × ℕ)} {root : Digest}
    (hin : LvIn rd σ lvl lv st ws R root) (hwt : WinTabs rd (σ (.n osWin)))
    (hok : AllOk C rd σ (osLevel c lvl lv st).1) :
    ∃ (xs : List E) (os : List Opening) (ws' : WhirStateT) (ms : List E) (r : OsRec),
      ReadsAt rd (st.cur σ) xs ∧
      RunsWithH (keyedHash S) (levelHead logN lvl level [] ws) (st.F σ) xs [os] R
        (ms, lv.logCols, ws') ((osLevel c lvl lv st).2.F σ) R ∧
      ms.length = c.yrLen ∧ ReadsAt rd (σ (.n osFmsg)) ms ∧
      ws'.glued = ws.glued ++ recClaims r ∧ RecStored rd σ c lvl lv r ∧
      ws'.folds.length = lv.foldsOff + lv.folds ∧
      (∀ j (h : j < ws'.folds.length), LoadHolds rd (σ (.n osFch)) j ws'.folds[j]) ∧
      ws'.quad = (osLevel c lvl lv st).2.quad σ ∧ ws'.target = σ (.n (osLevel c lvl lv st).2.t) ∧
      (osLevel c lvl lv st).2.fs.length = 5 ∧ PadOk σ (osLevel c lvl lv st).2.pad ∧
      (osLevel c lvl lv st).2.co ≤ 8 ∧
      (osLevel c lvl lv st).2.cur σ = st.cur σ * gen ^ xs.length ∧
      os = lvOsK rd σ V W lvl lv (osQCall c lvl lv st) ∧
      xs.length = 2 * lv.folds + (c.yrLen + 1) + 2 ∧
      MatsOk σ (osLevel c lvl lv st).2.mats := by
  have hc : (lvl = c.yrLevel) = True := eq_true hfin
  rw [osLevel_split] at hok ⊢
  rw [allOk_append] at hok
  obtain ⟨hA, hB⟩ := hok
  simp only [osLevelA, hc, ↓reduceIte] at hA hB ⊢
  rw [allOk_append, allOk_append] at hA
  obtain ⟨⟨hF, hC⟩, hG⟩ := hA
  obtain ⟨xs1, chs, hx1, hcl, hrd1, hrun1, hcur1, hfs1, hco1, hch⟩ :=
    osFolds_sound (fun _ _ h ↦ opening_foldK (hle _ _ _ h)) osFch lv.folds
      lv.foldsOff st ws [] hin.fs (by have := hin.co; unfold u128Bound; omega) hin.quad hin.t hF
  set st1 := (osFolds osFch lv.foldsOff lv.folds st).2
  have hco1' : st1.co = 0 := hco1.resolve_left (by omega)
  obtain ⟨ms, nonce, hmsl, hrd2, hfm, hrun2, hcur2, hfs2⟩ :=
    osFinal_sound hlen hcb.fm hcb.grind hfs1 (by rw [hco1']; unfold u128Bound; norm_num)
      (allOk_mono hle (allOk_append.mpr ⟨hC, hG⟩))
  set st2 := (osFinal c st1).2.1
  have hpad2 : st2.pad = st.pad := (osFolds_state' osFch lv.folds lv.foldsOff st).1
  obtain ⟨xs3, os, ws', lam, qs, hos, hrd3, hxl3, hrun3, hq3, ht3, ⟨enf, intro, hws'⟩, hrec, hfs3, hpad3,
      hcb3, hco3, hmats3⟩ :=
    osLevelB_soundK hle (lf := [] ++ chs) (ws := { ws with
        target := σ (.n st1.t)
        quad := st1.quad σ
        folds := ws.folds ++ chs })
      (pending := []) (R := R)
      hU hS2 hS3 hcfg hB hcb.q hrate hwt W hQW hfs2 (by rw [hpad2]; exact hin.pad)
      (by show MatsOk σ st1.mats; rw [osFolds_mats]; exact hin.mats)
      rfl rfl (by simpa using hcl) (fun j hj ↦ by
        have := hch j (by rw [hcl]; exact hj)
        rw [List.nil_append, List.getD_eq_getElem _ _ (by rw [hcl]; exact hj)]
        exact this) hin.R hin.r0 hin.r1
      (by unfold PendOk; simp only [hc, ↓reduceIte])
  have hfl : (ws.folds ++ chs).length = lv.foldsOff + lv.folds := by
    rw [List.length_append, hin.folds, hcl]
  have hml' : logN - (ws.folds ++ chs).length = lv.logCols := by rw [hfl, hml]
  rw [List.nil_append, glue_one] at hws'
  have hwf : ws'.folds = ws.folds ++ chs := by rw [hws']
  have hwg : ws'.glued = ws.glued ++ [⟨1 * lam, (ws.folds ++ chs).length,
      fun x ↦ inducedWeight lv.logCols qs (powers lam qs.length) x⟩] := by rw [hws']
  rw [levelHead_eq]
  have r1 := RunsTo.withRootsH (H := keyedHash S) hrun1 R
  rw [← hfold] at r1
  have r2 : RunsWithH (keyedHash S) (do
        let r ← levelMid (logN - (ws.folds ++ chs).length) []
        VerifierProgram.grindProofOfWork Whir.queryGrindingBits
        pure r) (st1.F σ) (ms ++ [nonce]) [] R (ms, []) ⟨st2.fsv σ, []⟩ R := by
    rw [hml']; exact RunsTo.withRootsH (H := keyedHash S) hrun2 R
  have r3 : RunsWithH (keyedHash S) (levelRest (logN - (ws.folds ++ chs).length) lvl level ([] ++ chs)
      { ws with
        target := σ (.n st1.t)
        quad := st1.quad σ
        folds := ws.folds ++ chs } []) ⟨st2.fsv σ, []⟩ xs3 [os] R ws'
      ((osLevelB c lvl lv st2).2.F σ) R := by
    rw [hml']; exact hrun3
  refine ⟨xs1 ++ ((ms ++ [nonce]) ++ (xs3 ++ [])), os, ws', ms,
    ⟨lam, qs, none, lv.foldsOff + lv.folds, lv.logCols⟩, ?_, ?_, hmsl, hfm, ?_, ?_, ?_, ?_, hq3,
    ht3, hfs3, hpad3, ?_, ?_, ?_, ?_, hmats3⟩
  · refine readsAt_append hrd1 (readsAt_append ?_ ?_)
    · rw [hx1, ← hcur1]; exact hrd2
    · rw [List.append_nil, hx1, ← hcur1, List.length_append, hmsl, show [nonce].length = 1 from rfl,
        ← hcur2]
      exact hrd3
  · refine RunsWithH.of_eq (RunsWithH.bind r1 (RunsWithH.bind r2 (RunsWithH.bind r3
      (runsWithH_ret _ _ _)))) rfl rfl rfl rfl ?_ rfl rfl
    simp only [hml']
  · rw [hwg, hfl]; rfl
  · exact ⟨hrec, ⟨fun _ ↦ rfl, fun h ↦ absurd hfin h, fun z' hz ↦ by cases hz⟩, rfl, rfl⟩
  · rw [hwf, hfl]
  · intro j hj
    simp only [hwf] at hj ⊢
    rcases Nat.lt_or_ge j ws.folds.length with h | h
    · rw [List.getElem_append_left h]; exact hin.fch j h
    · rw [List.getElem_append_right h]
      have := hch (j - ws.folds.length) (by simp at hj; omega)
      have e : lv.foldsOff + (j - ws.folds.length) = j := by rw [← hin.folds]; omega
      rwa [e] at this
  · rw [hco3]; simp [st2, osFinal]
  · simp only [OsSt.cur, hcb3, hco3, List.length_append, List.length_cons, List.length_nil, hxl3,
      hmsl]
    have := hcur2
    simp only [OsSt.cur] at this hcur1
    rw [pow_add, ← mul_assoc, this, hcur1, hx1]
    ring
  · rw [hos]
    simp only [bOsK, lvOsK, osQCall, hc, ↓reduceIte]
    rfl
  · simp only [List.length_append, hx1, hxl3, hmsl, List.length_cons, List.length_nil]; omega

/-- The callees, level by level. -/
def CalleesOkK (rd : Reader) (c : OsCfg) : ℕ → List OsLv → Prop
  | _, [] => True
  | lvl, lv :: lvs => LvCalleesK rd c lvl lv ∧ CalleesOkK rd c (lvl + 1) lvs

theorem calleesOk_atK {rd : Reader} {c : OsCfg} : ∀ {lvs : List OsLv} {lvl : ℕ},
    CalleesOkK rd c lvl lvs → ∀ i (hi : i < lvs.length), LvCalleesK rd c (lvl + i) lvs[i]
  | [], _, _, i, hi => absurd hi (by simp)
  | _ :: _, _, h, 0, _ => by simpa using h.1
  | _ :: rest, lvl, h, i + 1, hi => by
    have := calleesOk_atK h.2 i (by simpa using hi)
    rwa [show lvl + 1 + i = lvl + (i + 1) by ring] at this

/-- The levels' `opening_queries` calls of `C`, sound with their queries `Wf lvl lv`. -/
def QWOkK (rd : Reader) (C : CallRel) (Wf : ℕ → OsLv → List E → List E → List QW) :
    ℕ → List OsLv → Prop
  | _, [] => True
  | lvl, lv :: lvs => LvQWK rd C lvl lv (Wf lvl lv) ∧ QWOkK rd C Wf (lvl + 1) lvs

/-- **The levels** run `whirLevelsHead`, on the openings their queries' witnesses name. -/
theorem osLevels_soundK {c : OsCfg} {logN : ℕ} {C : CallRel} (hle : CallRel.Le C (SaltedGuest.coreProgram.Rel rd))
    {V : SaltedGuest.End.FrameMap} (hU : SaltedGuest.End.UnfoldsV rd C V)
    {S : Digest} (hS2 : LoadHolds rd 1 2 (digestHalves S).1)
    (hS3 : LoadHolds rd 1 3 (digestHalves S).2)
    {Wf : ℕ → OsLv → List E → List E → List QW} : ∀ (lvs : List OsLv) (cfg : List Whir.Level)
    (lvl : ℕ) (st : OsSt) (ws : WhirStateT) (R : List (Digest × ℕ × ℕ)) (root : Digest),
    LevelsOk c logN lvl lvs cfg → CalleesOkK rd c lvl lvs → QWOkK rd C Wf lvl lvs →
    RatesOk σ c lvl lvs →
    LvIn rd σ lvl (lvs.headD default) st ws R root → WinTabs rd (σ (.n osWin)) →
    AllOk C rd σ (osLevels c lvl lvs st).1 →
    ∃ (xs : List E) (os : List (List Opening)) (R' : List (Digest × ℕ × ℕ)) (ms : List E)
      (ws' : WhirStateT) (rs : List OsRec),
      ReadsAt rd (st.cur σ) xs ∧
      RunsWithH (keyedHash S) (whirLevelsHead logN lvl cfg ws) (st.F σ) xs os R
        (ms, (lvs.getLastD default).logCols, ws') ((osLevels c lvl lvs st).2.F σ) R' ∧
      ms.length = c.yrLen ∧ ReadsAt rd (σ (.n osFmsg)) ms ∧
      ws'.glued = ws.glued ++ rs.flatMap recClaims ∧ rs.length = lvs.length ∧
      (∀ i (hi : i < rs.length) (hi' : i < lvs.length), RecStored rd σ c (lvl + i) lvs[i] rs[i]) ∧
      ws'.folds.length = (lvs.getLastD default).foldsOff + (lvs.getLastD default).folds ∧
      (∀ j (h : j < ws'.folds.length), LoadHolds rd (σ (.n osFch)) j ws'.folds[j]) ∧
      ws'.quad = (osLevels c lvl lvs st).2.quad σ ∧
      ws'.target = σ (.n (osLevels c lvl lvs st).2.t) ∧
      (osLevels c lvl lvs st).2.fs.length = 5 ∧ PadOk σ (osLevels c lvl lvs st).2.pad ∧
      (osLevels c lvl lvs st).2.co ≤ 8 ∧
      (osLevels c lvl lvs st).2.cur σ = st.cur σ * gen ^ xs.length ∧
      os = (osQCalls c lvl lvs st).map (fun e ↦ lvOsK rd σ V (Wf e.1 e.2.1) e.1 e.2.1 e.2.2) ∧
      xs.length = lvsWords c lvl lvs ∧ MatsOk σ (osLevels c lvl lvs st).2.mats
  | [lv], [level], lvl, st, ws, R, root, hok, hcal, hqw, hrat, hin, hwt, hall => by
    obtain ⟨hcfg, hfold, h4, hml, hlen, hfin⟩ := hok
    have hall' : AllOk C rd σ (osLevel c lvl lv st).1 := by
      have := (allOk_append.mp hall).1
      exact this
    obtain ⟨xs, os, ws', ms, r, hrd, hrun, hmsl, hfm, hgl, hrec, hfl, hfch, hq, ht, hfs, hpad,
      hco, hcur, hos, hxl, hmt⟩ := osLevel_final_soundK hle hU hS2 hS3 hqw.1 hcal.1 hrat.1 hcfg hfold h4 hml hlen
        hfin hin hwt hall'
    exact ⟨xs, [os], R, ms, ws', [r], hrd, hrun, hmsl, hfm, by simpa using hgl, rfl,
      fun i hi _ ↦ by
        obtain rfl : i = 0 := by simpa using hi
        simpa using hrec, hfl, hfch, hq, ht, hfs, hpad, hco, hcur,
      by rw [hos]; simp [osQCalls], by rw [hxl]; simp [lvsWords, hfin], hmt⟩
  | lv :: lv' :: lvs, level :: next :: cfg, lvl, st, ws, R, root, hok, hcal, hqw, hrat, hin, hwt,
      hall => by
    obtain ⟨hcfg, hfold, h4, hml, hm, hlvl, hnf, hoff', hshape, hrest⟩ := hok
    have e1 : osLevels c lvl (lv :: lv' :: lvs) st =
        ((osLevel c lvl lv st).1 ++ (osLevels c (lvl + 1) (lv' :: lvs) (osLevel c lvl lv st).2).1,
          (osLevels c (lvl + 1) (lv' :: lvs) (osLevel c lvl lv st).2).2) := rfl
    rw [e1] at hall ⊢
    rw [allOk_append] at hall
    obtain ⟨xs1, os1, ws1, root', r, hrd1, hrun1, hin1, hgl1, hrec1, hcur1, hos1, hxl1⟩ :=
      osLevel_nonfinal_soundK (rest := cfg) hle hU hS2 hS3 hqw.1 hcal.1 hrat.1 hcfg hfold h4 hml hm hlvl
        hnf hoff' hshape hin hwt hall.1
    obtain ⟨xs2, os2, R', ms, ws', rs, hrd2, hrun2, hmsl, hfm, hgl2, hrl, hrec2, hfl, hfch, hq,
      ht, hfs, hpad, hco, hcur2, hos2, hxl2, hmt⟩ :=
      osLevels_soundK hle hU hS2 hS3 (lv' :: lvs) (next :: cfg) (lvl + 1) _ ws1 _ root' hrest hcal.2 hqw.2
        hrat.2 hin1 hwt hall.2
    refine ⟨xs1 ++ xs2, [os1] ++ os2, R', ms, ws', r :: rs, readsAt_append hrd1 (by
        rw [← hcur1]; exact hrd2), ?_, hmsl, hfm, ?_, by simp [hrl], ?_, hfl, hfch, hq, ht, hfs,
      hpad, hco, ?_, ?_, ?_, hmt⟩
    · exact RunsWithH.bind hrun1 hrun2
    · rw [hgl2, hgl1]; simp
    · intro i hi hi'
      rcases i with _ | i
      · simpa using hrec1
      · have := hrec2 i (by simpa using hi) (by simpa using hi')
        rw [show lvl + 1 + i = lvl + (i + 1) by ring] at this
        simpa using this
    · rw [hcur2, hcur1, List.length_append, pow_add, mul_assoc]
    · rw [hos1, hos2]; simp [osQCalls]
    · rw [List.length_append, hxl1, hxl2]; simp [lvsWords, hnf]
  | [], _, _, _, _, _, _, hok, _, _, _, _, _, _ => by simp [LevelsOk] at hok
  | [_], [], _, _, _, _, _, hok, _, _, _, _, _, _ => by simp [LevelsOk] at hok
  | [_], _ :: _ :: _, _, _, _, _, _, hok, _, _, _, _, _, _ => by simp [LevelsOk] at hok
  | _ :: _ :: _, [], _, _, _, _, _, hok, _, _, _, _, _, _ => by simp [LevelsOk] at hok
  | _ :: _ :: _, [_], _, _, _, _, _, hok, _, _, _, _, _, _ => by simp [LevelsOk] at hok

end
end LeanVM.SaltedGuest.B1.Whir
