/-
  LeanVM.SaltedGuest.B1.Main.WorldK

  The salted `main`'s coverage table, filled, and the decoders read off it: the deployed `Main.World`
  and `Main.Decode` over `MainFactsK`.
-/

module

public import LeanVM.SaltedGuest.B1.Main.KidsK

/-!
# The salted `main`'s coverage table

The deployed `Main.World` and `Main.Decode` (the segments, the running counts, the writers, the
decoded children's statements) at `MainFactsK` and `KidOkK`, generated by
`scripts/salted-main/maincopy.py`: they read no hash.
-/

namespace LeanVM.SaltedGuest.B1.Main

open LeanVM.Parameters LeanVM.Semantics LeanVM.Guest.Core LeanVM.Guest.Value LeanVM.Guest.Value.Keccak
open LeanVM.Protocol LeanVM.Protocol.KeccakHash LeanVM.Protocol.Compile LeanVM.Protocol.Verifier
open LeanVM.Guest.B1.Digest LeanVM.Node
open LeanVM.Guest.B1 LeanVM.Guest.B1.Main LeanVM.SaltedGuest.B1 Recursion.Salted

@[expose] public section

variable {C : CallRel}

variable {S : Digest} {key : E}

variable {rd : Reader} {σ : Val} {K : ℕ → KidRec}

theorem a_leK (MF : MainFactsK C rd σ S key) (hK : ∀ c < lg σ 6, KidOkK C rd σ S c (K c)) :
    ∀ c ≤ lg σ 6, (segsOf σ K).a c ≤ 2 ^ 33 + c * 2 ^ 33 := by
  intro c
  induction c with
  | zero =>
    intro _
    have h2 := (MF.counts 2 (by simp)).2
    have h5 := (MF.counts 5 (by simp)).2
    rw [Segs.a.eq_1, segsOf_RX, segsOf_RS]
    omega
  | succ c ih =>
    intro hc
    have := ih (by omega)
    obtain ⟨b1, b2⟩ := (hK c (by omega)).bounds
    rw [Segs.a.eq_2, segsOf_ex, segsOf_es]
    nlinarith

/-- **The running counts**: `written[c] = g^(a c)`. -/
theorem written_eqK (MF : MainFactsK C rd σ S key) (hK : ∀ c < lg σ 6, KidOkK C rd σ S c (K c)) :
    ∀ c ≤ lg σ 6, LoadHolds rd (σ (.n 399)) c (gen ^ (segsOf σ K).a c) := by
  intro c
  induction c with
  | zero => intro _; rw [Segs.a.eq_1, segsOf_RX, segsOf_RS]; exact MF.written0
  | succ c ih =>
    intro hc
    have hk := hK c (by omega)
    have hb := loadHolds_unique hk.base (ih (by omega))
    have := hk.next
    rw [hb, ← pow_add, ← pow_add] at this
    rw [Segs.a.eq_2, segsOf_ex, segsOf_es]
    exact this

/-- **The last running count is the coverage table's size.** -/
theorem a_totalK (MF : MainFactsK C rd σ S key) (hK : ∀ c < lg σ 6, KidOkK C rd σ S c (K c)) :
    (segsOf σ K).a (lg σ 6) = LXS σ + LSS σ := by
  have hT := MF.total
  have eX : LXS σ = lg σ 0 + lg σ 1 := rfl
  have eS : LSS σ = lg σ 3 + lg σ 4 := rfl
  have h2 := MF.writtenN
  rw [hT.1] at h2
  have := loadHolds_unique (written_eqK MF hK (lg σ 6) le_rfl) h2
  have hb := a_leK MF hK (lg σ 6) le_rfl
  have hk6 := MF.kids.2
  have hb' : (segsOf σ K).a (lg σ 6) < 2 ^ 64 - 1 := by
    have : lg σ 6 * 2 ^ 33 ≤ 16 * 2 ^ 33 := Nat.mul_le_mul_right _ hk6
    omega
  exact gen_pow_inj hb' (by omega) this

/-- **Every running count is below `2^32`**: at most the last. -/
theorem a_ltK (MF : MainFactsK C rd σ S key) (hK : ∀ c < lg σ 6, KidOkK C rd σ S c (K c)) {c : ℕ}
    (hc : c ≤ lg σ 6) : (segsOf σ K).a c < 2 ^ 32 := by
  have h := (segsOf σ K).a_mono hc
  rw [a_totalK MF hK] at h
  have hT := MF.total.2
  have eX : LXS σ = lg σ 0 + lg σ 1 := rfl
  have eS : LSS σ = lg σ 3 + lg σ 4 := rfl
  omega

/-- **The raw signatures' slots**: one slot of its region per raw signature, holding its mark. -/
theorem raw_slotsK (MF : MainFactsK C rd σ S key) :
    ∃ rx rs : ℕ → ℕ, (∀ i < lg σ 2, rx i < LXS σ ∧ LoadHolds rd (σ (.n 45)) (rx i) (gen ^ i)) ∧
      ∀ j < lg σ 5, rs j < LSS σ ∧
        LoadHolds rd (σ (.n 45)) (LXS σ + rs j) (gen ^ (lg σ 2 + j)) := by
  have hT := MF.total
  have h40 := MF.lxs
  have h41 := MF.lss
  have hc2 := (MF.counts 2 (by simp)).1
  have eX : LXS σ = lg σ 0 + lg σ 1 := rfl
  have eS : LSS σ = lg σ 3 + lg σ 4 := rfl
  have hx : ∀ i, i < lg σ 2 → ∃ s, s < LXS σ ∧ LoadHolds rd (σ (.n 45)) s (gen ^ i) := by
    intro i hi
    obtain ⟨-, s, hbl, hl⟩ := MF.rawx i hi
    exact ⟨s, belowLog_lt (by omega) h40 hbl, hl⟩
  have hs : ∀ j, j < lg σ 5 → ∃ s, s < LSS σ ∧
      LoadHolds rd (σ (.n 45)) (LXS σ + s) (gen ^ (lg σ 2 + j)) := by
    intro j hj
    obtain ⟨s, hbl, hl, -⟩ := MF.raws j hj
    refine ⟨s, belowLog_lt (by omega) h41 hbl, ?_⟩
    rw [h40, hc2, ← pow_add, ← pow_add, loadHolds_gen_pow_iff, Nat.add_zero] at hl
    exact hl
  choose! rx hrx using hx
  choose! rs hrs using hs
  exact ⟨rx, rs, hrx, hrs⟩

section Slots

variable {rx rs : ℕ → ℕ}

end Slots

/-- A child's base is the running count before it. -/
theorem kid_baseK (MF : MainFactsK C rd σ S key) (hK : ∀ c < lg σ 6, KidOkK C rd σ S c (K c)) {c : ℕ}
    (hc : c < lg σ 6) : (K c).base = gen ^ (segsOf σ K).a c :=
  loadHolds_unique (hK c hc).base (written_eqK MF hK c (by omega))

/-- **Child `c`'s leanXMSS claim `j`**: its slot below `LXS`, holding its writer's mark. -/
theorem kid_wxK (MF : MainFactsK C rd σ S key) (hK : ∀ c < lg σ 6, KidOkK C rd σ S c (K c)) {c j : ℕ}
    (hc : c < lg σ 6) (hj : j < (K c).ex) :
    (K c).ox j < LXS σ ∧ LoadHolds rd (σ (.n 45)) ((K c).ox j)
      (gen ^ (segsOf σ K).wmark ((segsOf σ K).a c + j)) := by
  have hT := MF.total.2
  obtain ⟨hbl, hl, -⟩ := (hK c hc).xrec j hj
  refine ⟨slotBelow_lt (by unfold LXS; omega) MF.lxs hbl, ?_⟩
  rw [(segsOf σ K).wmark_x (by rw [segsOf_NC]; exact hc) (by omega) (by rw [segsOf_ex]; omega),
    segsOf_mx]
  rw [kid_baseK MF hK hc, ← pow_add] at hl
  cases hm : (K c).mx <;> simp only [hm, Bool.false_eq_true, ↓reduceIte, Nat.add_zero] at hl ⊢ <;>
    exact hl

/-- **Child `c`'s leanSPHINCS claim `j`**: its slot below `LSS` past `LXS`, holding its writer's
mark. -/
theorem kid_wsK (MF : MainFactsK C rd σ S key) (hK : ∀ c < lg σ 6, KidOkK C rd σ S c (K c)) {c j : ℕ}
    (hc : c < lg σ 6) (hj : j < (K c).es) :
    (K c).os j < LSS σ ∧ LoadHolds rd (σ (.n 45)) (LXS σ + (K c).os j)
      (gen ^ (segsOf σ K).wmark ((segsOf σ K).a c + (K c).ex + j)) := by
  have hT := MF.total.2
  obtain ⟨hbl, hl, -⟩ := (hK c hc).srec j hj
  refine ⟨slotBelow_lt (by unfold LSS; omega) MF.lss hbl, ?_⟩
  rw [(segsOf σ K).wmark_s (by rw [segsOf_NC]; exact hc) (by rw [segsOf_ex]; omega)
    (by rw [Segs.a_succ, segsOf_ex, segsOf_es]; omega), segsOf_ms, segsOf_ex]
  rw [MF.spcov, MF.lxs, kid_baseK MF hK hc, ← pow_add, ← pow_add, loadHolds_gen_pow_iff] at hl
  cases hm : (K c).ms <;> simp only [hm, Bool.false_eq_true, ↓reduceIte, Nat.add_zero] at hl ⊢ <;>
    exact hl

set_option maxRecDepth 20000 in
/-- **The writersK of the coverage table.** -/
theorem writersK (MF : MainFactsK C rd σ S key) (hK : ∀ c < lg σ 6, KidOkK C rd σ S c (K c)) {rx rs : ℕ → ℕ}
    (hrx : ∀ i < lg σ 2, rx i < LXS σ ∧ LoadHolds rd (σ (.n 45)) (rx i) (gen ^ i))
    (hrs : ∀ j < lg σ 5, rs j < LSS σ ∧
      LoadHolds rd (σ (.n 45)) (LXS σ + rs j) (gen ^ (lg σ 2 + j))) :
    Writers rd (σ (.n 45)) (segsOf σ K) (LXS σ) (LSS σ) (slOf σ K rx rs) := by
  have hT := MF.total
  have eX : LXS σ = lg σ 0 + lg σ 1 := rfl
  have eS : LSS σ = lg σ 3 + lg σ 4 := rfl
  have hw := written_eqK MF hK
  have htot : (segsOf σ K).a (segsOf σ K).NC = LXS σ + LSS σ := by
    rw [segsOf_NC]; exact a_totalK MF hK
  set S := segsOf σ K with hS
  have hRX : S.RX = lg σ 2 := rfl
  have hRS : S.RS = lg σ 5 := rfl
  -- every writer: raw leanXMSS, raw leanSPHINCS, a child's leanXMSS or leanSPHINCS claim
  have cases_m : ∀ m < LXS σ + LSS σ, m < lg σ 2 ∨ (lg σ 2 ≤ m ∧ m < lg σ 2 + lg σ 5) ∨
      ∃ c < lg σ 6, (∃ j < (K c).ex, m = S.a c + j) ∨
        ∃ j < (K c).es, m = S.a c + (K c).ex + j := by
    intro m hm
    by_cases h1 : m < lg σ 2
    · exact Or.inl h1
    by_cases h2 : m < lg σ 2 + lg σ 5
    · exact Or.inr (Or.inl ⟨by omega, h2⟩)
    obtain ⟨hc, hc1, hc2⟩ := S.kid_spec (m := m) (by simp [Segs.a, hRX, hRS]; omega)
      (by rw [htot]; exact hm)
    rw [Segs.a_succ, hS, segsOf_ex, segsOf_es, segsOf_NC] at *
    refine Or.inr (Or.inr ⟨_, hc, ?_⟩)
    by_cases hx : m - (segsOf σ K).a ((segsOf σ K).kid m) < (K ((segsOf σ K).kid m)).ex
    · exact Or.inl ⟨_, hx, by omega⟩
    · exact Or.inr ⟨m - (segsOf σ K).a ((segsOf σ K).kid m) - (K ((segsOf σ K).kid m)).ex,
        by omega, by omega⟩
  refine ⟨fun m hm => ?_, fun m hm => ?_, fun m₁ m₂ h12 hm₂ heq => ?_, htot, by omega⟩
  · -- the marks
    rcases cases_m m hm with h | ⟨h1, h2⟩ | ⟨c, hc, ⟨j, hj, rfl⟩ | ⟨j, hj, rfl⟩⟩
    · rw [slOf_rx h, S.wmark_raw (by rw [hRX, hRS]; omega)]; exact (hrx m h).2
    · rw [slOf_rs h1 h2, S.wmark_raw (by rw [hRX, hRS]; omega)]
      have := (hrs (m - lg σ 2) (by omega)).2
      rwa [show lg σ 2 + (m - lg σ 2) = m by omega] at this
    · rw [slOf_x hc hj]; exact (kid_wxK MF hK hc hj).2
    · rw [slOf_s hc hj]; exact (kid_wsK MF hK hc hj).2
  · -- the regions
    rcases cases_m m hm with h | ⟨h1, h2⟩ | ⟨c, hc, ⟨j, hj, rfl⟩ | ⟨j, hj, rfl⟩⟩
    · have hr : S.region m = 0 := by unfold Segs.region; rw [hRX, ite_pos' h]
      rw [hr, slOf_rx h]
      exact ⟨fun _ => (hrx m h).1, fun h => absurd h (by decide)⟩
    · have hr : S.region m = 1 := by
        unfold Segs.region; rw [hRX, hRS, ite_neg' (by omega), ite_pos' h2]
      rw [hr, slOf_rs h1 h2]
      have := (hrs (m - lg σ 2) (by omega)).1
      exact ⟨fun h => absurd h (by decide), fun _ => ⟨by omega, by omega⟩⟩
    · have h0 := S.a0_le c
      rw [hRX, hRS] at h0
      have hk := S.kid_eq (m := S.a c + j) (by rw [hS, segsOf_NC]; exact hc) (by omega)
        (by rw [Segs.a_succ, hS, segsOf_ex, segsOf_es]; omega)
      have hr : S.region (S.a c + j) = 0 := by
        unfold Segs.region
        rw [hRX, hRS, ite_neg' (by omega), ite_neg' (by omega), hk, hS, segsOf_ex,
          ite_pos' (by omega)]
      rw [hr, slOf_x hc hj]
      exact ⟨fun _ => (kid_wxK MF hK hc hj).1, fun h => absurd h (by decide)⟩
    · have h0 := S.a0_le c
      rw [hRX, hRS] at h0
      have hk := S.kid_eq (m := S.a c + (K c).ex + j) (by rw [hS, segsOf_NC]; exact hc)
        (by omega) (by rw [Segs.a_succ, hS, segsOf_ex, segsOf_es]; omega)
      have hr : S.region (S.a c + (K c).ex + j) = 1 := by
        unfold Segs.region
        rw [hRX, hRS, ite_neg' (by omega), ite_neg' (by omega), hk, hS, segsOf_ex,
          ite_neg' (by omega)]
      rw [hr, slOf_s hc hj]
      have := (kid_wsK MF hK hc hj).1
      exact ⟨fun h => absurd h (by decide), fun _ => ⟨by omega, by omega⟩⟩
  · -- one mark, a gap-walked list: increasing slots
    have hle1 := (S.wmark_range (m := m₁) (by rw [htot]; omega)).1
    rcases cases_m m₂ hm₂ with h | ⟨h1, h2⟩ | ⟨c, hc, ⟨j, hj, rfl⟩ | ⟨j, hj, rfl⟩⟩
    · rw [S.wmark_raw (m := m₂) (by rw [hRX, hRS]; omega)] at heq; omega
    · rw [S.wmark_raw (m := m₂) (by rw [hRX, hRS]; omega)] at heq; omega
    · have hcN : c < S.NC := by rw [hS, segsOf_NC]; exact hc
      have hex : S.ex c = (K c).ex := rfl
      have hmx : S.mx c = (K c).mx := rfl
      rw [S.wmark_x (m := S.a c + j) hcN (by omega) (by rw [hex]; omega), hmx] at heq
      cases hm : (K c).mx
      · rw [hm] at heq; simp only [Bool.false_eq_true, ↓reduceIte] at heq; omega
      · rw [hm] at heq; simp only [↓reduceIte] at heq
        obtain ⟨i, rfl⟩ : ∃ i, m₁ = S.a c + i := ⟨m₁ - S.a c, by omega⟩
        rw [slOf_x hc (by omega), slOf_x hc hj]
        exact (hK c hc).xmono hm i j (by omega) hj
    · have hcN : c < S.NC := by rw [hS, segsOf_NC]; exact hc
      have hex : S.ex c = (K c).ex := rfl
      have hes : S.es c = (K c).es := rfl
      have hms : S.ms c = (K c).ms := rfl
      rw [S.wmark_s (m := S.a c + (K c).ex + j) hcN (by rw [hex]; omega)
        (by rw [Segs.a_succ, hex, hes]; omega), hms, hex] at heq
      cases hm : (K c).ms
      · rw [hm] at heq; simp only [Bool.false_eq_true, ↓reduceIte] at heq; omega
      · rw [hm] at heq; simp only [↓reduceIte] at heq
        obtain ⟨i, rfl⟩ : ∃ i, m₁ = S.a c + (K c).ex + i := ⟨m₁ - S.a c - (K c).ex, by omega⟩
        rw [slOf_s hc (by omega), slOf_s hc hj]
        have := (hK c hc).smono hm i j (by omega) hj
        omega

end
end LeanVM.SaltedGuest.B1.Main

namespace LeanVM.SaltedGuest.B1.Main

open LeanVM.Parameters LeanVM.Semantics LeanVM.Guest.Core LeanVM.Guest.Value LeanVM.Guest.Value.Keccak
open LeanVM.Protocol LeanVM.Protocol.KeccakHash LeanVM.Protocol.Compile LeanVM.Protocol.Verifier
open LeanVM.Guest.B1.Digest LeanVM.Node
open LeanVM.Guest.B1 LeanVM.Guest.B1.Main LeanVM.SaltedGuest.B1 Recursion.Salted

@[expose] public section

variable {C : CallRel}

variable {S : Digest} {key : E}

variable {rd : Reader} {σ : Val} {K : ℕ → KidRec} {sl : ℕ → ℕ}

theorem lxSlots_eqK (MF : MainFactsK C rd σ S key) : lxSlots σ = LXS σ := by
  have hT := MF.total.2
  unfold lxSlots; rw [MF.lxs, gLog_gen_pow (by omega)]

theorem lsSlots_eqK (MF : MainFactsK C rd σ S key) : lsSlots σ = LSS σ := by
  have hT := MF.total.2
  unfold lsSlots; rw [MF.lss, gLog_gen_pow (by omega)]

theorem countOf_eqK (MF : MainFactsK C rd σ S key) (hK : ∀ c < lg σ 6, KidOkK C rd σ S c (K c)) {c : ℕ}
    (hc : c ≤ lg σ 6) : countOf rd σ c = (segsOf σ K).a c := by
  have hb := a_ltK MF hK hc
  unfold countOf
  rw [cellAt_eq_memAt, memAt_of_load (written_eqK MF hK c hc), gLog_gen_pow (by omega)]

section Kid

variable {rx rs : ℕ → ℕ}

/-- **Child `c`'s statement, read off the coverage table**, is its records'. -/
theorem kidStmt_eqK (MF : MainFactsK C rd σ S key) (hK : ∀ c < lg σ 6, KidOkK C rd σ S c (K c))
    (hW : Writers rd (σ (.n 45)) (segsOf σ K) (LXS σ) (LSS σ) (slOf σ K rx rs)) {c : ℕ}
    (hc : c < lg σ 6) :
    kidStmt rd σ c =
      ⟨⟨(List.range (K c).ex).map fun j => xmssAt rd (σ (.n 31)) ((K c).ox j),
        (List.range (K c).es).map fun j => sphincsAt rd (σ (.n 34)) ((K c).os j),
        daDigestAt rd σ c⟩,
       deferOfCells (readCells rd (σ (.n 396) * gen ^ (24 * c)) 24)⟩ := by
  have hT := MF.total.2
  have eX : LXS σ = lg σ 0 + lg σ 1 := rfl
  have eS : LSS σ = lg σ 3 + lg σ 4 := rfl
  have hcN : c < (segsOf σ K).NC := by rw [segsOf_NC]; exact hc
  have htot := hW.total
  have hab : (segsOf σ K).a (c + 1) ≤ LXS σ + LSS σ := by
    rw [← htot]; exact (segsOf σ K).a_mono (by omega)
  have hsucc : (segsOf σ K).a (c + 1) = (segsOf σ K).a c + ((K c).ex + (K c).es) := by
    rw [Segs.a_succ, segsOf_ex, segsOf_es]
  have hmk : ∀ s, markOf rd σ s = markAt rd (σ (.n 45)) s := fun s => markOf_eq s
  -- the leanXMSS list
  obtain ⟨hnx, hX⟩ := kidSlots_eq (rd := rd) (σ := σ) (lo := 0) (len := LXS σ)
    (a := (segsOf σ K).a c) (b := (segsOf σ K).a (c + 1)) (mono := (K c).mx) (K c).ox
    (fun j hj => by
      refine ⟨(kid_wxK MF hK hc hj).1, ?_⟩
      rw [Nat.zero_add, hmk, ← slOf_x (rx := rx) (rs := rs) hc hj, markAt_sl hW (by omega),
        (segsOf σ K).wmark_x hcN (by omega) (by rw [segsOf_ex]; omega), segsOf_mx]
      split <;> simp)
    (fun i hi j hj h => by
      rw [← slOf_x (rx := rx) (rs := rs) hc hi, ← slOf_x (rx := rx) (rs := rs) hc hj] at h
      have := hW.inj _ (by omega) _ (by omega) h
      omega)
    (hK c hc).xmono (by omega)
    (fun s hs h1 h2 => by
      rw [Nat.zero_add, hmk] at h1 h2
      exact (kid_writer hW hc (by omega) h1 h2).1 hs)
  -- the leanSPHINCS list
  obtain ⟨-, hS⟩ := kidSlots_eq (rd := rd) (σ := σ) (lo := LXS σ) (len := LSS σ)
    (a := (segsOf σ K).a c + (K c).ex) (b := (segsOf σ K).a (c + 1)) (mono := (K c).ms) (K c).os
    (fun j hj => by
      refine ⟨(kid_wsK MF hK hc hj).1, ?_⟩
      rw [hmk, ← slOf_s (rx := rx) (rs := rs) hc hj, markAt_sl hW (by omega),
        (segsOf σ K).wmark_s hcN (by rw [segsOf_ex]; omega)
          (by rw [Segs.a_succ, segsOf_ex, segsOf_es]; omega), segsOf_ms, segsOf_ex]
      split <;> simp)
    (fun i hi j hj h => by
      have h' : slOf σ K rx rs ((segsOf σ K).a c + (K c).ex + i) =
          slOf σ K rx rs ((segsOf σ K).a c + (K c).ex + j) := by
        rw [slOf_s hc hi, slOf_s hc hj, h]
      have := hW.inj _ (by omega) _ (by omega) h'
      omega)
    (hK c hc).smono (by omega)
    (fun s hs h1 h2 => by
      rw [hmk] at h1 h2
      obtain ⟨j, hj, he⟩ := (kid_writer hW hc (by omega) (by omega) h2).2 (by omega)
      exact ⟨j, hj, by omega⟩)
  unfold kidStmt
  simp only [countOf_eqK MF hK (show c ≤ lg σ 6 by omega),
    countOf_eqK MF hK (show c + 1 ≤ lg σ 6 by omega), lxSlots_eqK MF, lsSlots_eqK MF, hnx, hX, hS,
    List.map_map]
  rfl

end Kid

end
end LeanVM.SaltedGuest.B1.Main
